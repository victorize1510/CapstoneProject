<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- Load theme, shared controls, panel styles, then the shared header. -->
    <ui:Style src="MenuTheme.uss" />
    <ui:Style src="MenuCommon.uss" />
    <ui:Style src="MenuPlaceholderPanel.uss" />
    <ui:VisualElement name="menu-placeholder-panel" class="menu-placeholder-panel menu-theme">
        <ui:Label name="menu-placeholder-title" text="Feature" class="menu-placeholder-title" />
        <ui:Label name="menu-placeholder-body" text="This panel is a clean placeholder. Connect the real gameplay system later." class="menu-placeholder-body" />
    </ui:VisualElement>
</ui:UXML>
