}

.pets-large-bar-label,
.pets-large-bar-value {
    font-size: 11px;
}

.pets-large-bar-label {
    width: 34px;
}

.pets-large-bar-value {
    width: 76px;
}

.pets-stats-card {
    height: 205px;
    min-height: 205px;
    margin-top: 3px;
    padding-top: 3px;
    padding-right: 9px;
    padding-bottom: 4px;
    padding-left: 9px;
}

.pets-stats-header {
    height: 27px;
