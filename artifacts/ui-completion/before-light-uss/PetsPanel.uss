}

.pets-stats-title {
    height: 25px;
    min-height: 25px;
    font-size: 17px;
}

.pets-section-link-button {
    width: 112px;
    min-width: 112px;
    height: 25px;
    font-size: 9px;
}

.pets-stats-columns {
    flex-direction: column;
}

.pets-stat-column {
    width: 100%;
    flex-basis: auto;
}

.pets-stat-row {
    height: 21px;
    min-height: 21px;
