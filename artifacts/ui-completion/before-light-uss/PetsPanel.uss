}

.pets-skills-header {
    height: 29px;
    min-height: 29px;
    margin-top: 2px;
}

.pets-skills-title {
    height: 27px;
    font-size: 16px;
}

.pets-skills-row {
    height: 82px;
    min-height: 82px;
}

.pet-skill-card {
    height: 76px;
    min-height: 76px;
    margin-left: 3px;
    margin-right: 3px;
    padding-top: 5px;
    padding-right: 7px;
    padding-bottom: 5px;
    padding-left: 7px;
}

.pet-skill-icon {
    width: 43px;
    min-width: 43px;
    height: 43px;
    border-radius: 22px;
}

.pet-skill-text {
    margin-left: 7px;
}

.pet-skill-name {
    font-size: 12px;
}

.pet-skill-meta {
    font-size: 10px;
}

.pets-actions-row {
    height: 76px;
    min-height: 76px;
    margin-top: 3px;
}

.pets-action-button {
    height: 70px;
    min-height: 70px;
    padding-top: 6px;
