--- !u!102 &6238591424199910146
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1566888051938668769}
  m_Text: "Thank you for downloading the assets!\n\nHere are some instructions and
    recommended settings for your project\nto achieve the same visuals as in the
    screenshots and video:\n\nIn your URP Settings (by default it's URP-HighFidelity
    in the Settings folder)\n1. Enable Depth Texture and Opaque Texture \n2. Switch
    the Grading Mode to High Dynamic Range\n3. In the renderer settings set Ambient
    Occlusion settings to Intensity - 0.2, Radius - 0.4\n\nNote: to control the wind
    use the TriForge Wind Controller script. You will also need\nto add it into any
    new scene you create with these assets if you wish to configure the wind.\n\nIf
    you have any questions or need support with the assets you can reach out to\nsupport@triforge.eu\n\nNote:
    to control the wind use the TriForge Wind Controller script. You will also need\nto
    add it into any new scene you create with these assets if you wish to configure
    the wind.\n\nIf you have any questions or need support with the assets you can
    reach out to\nsupport@triforge.eu\nFor support requests remember to include your
    Unity version, the render pipeline and its\nversion as well as purchase invoice
    number to speed up the process.\n"
  m_OffsetZ: 0
  m_CharacterSize: 1
  m_LineSpacing: 1
  m_Anchor: 0
  m_Alignment: 0
  m_TabSize: 4
  m_FontSize: 50
  m_FontStyle: 0
  m_RichText: 1
  m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
  m_Color:
    serializedVersion: 2
    rgba: 4294967295
