.unified-panel .companion-tabs {left:720px;top:124px;width:832px;height:44px;}
.unified-panel .companion-tab {height:44px;min-height:44px;}
.unified-panel .companion-inspector {left:704px;top:164px;width:864px;height:552px;}
.unified-panel .companion-dock {left:24px;top:748px;width:1552px;height:128px;}
.unified-panel.pets-panel.companion-panel .pets-party-row {top:8px;height:112px;min-height:0;}
.unified-panel .companion-missing-art {top:476px;}
.unified-panel .companion-mode {left:28px;top:532px;}
.unified-panel .companion-swap {top:24px;}
.unified-panel .r3-swap-actions {top:12px;}
