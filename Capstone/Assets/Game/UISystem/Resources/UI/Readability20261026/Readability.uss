.readability-ui .companion-design .companion-growth-reason {position:relative;height:auto;min-height:24px;margin-top:6px;white-space:normal;}
.readability-ui .ga-popup .ga-details-middle {height:auto;min-height:292px;align-items:stretch;}
.readability-ui .ga-popup .ga-details-basic,.readability-ui .ga-popup .ga-details-stats {height:auto;min-height:292px;}
.readability-ui .ga-popup .ga-section-title {font-size:22px;min-height:30px;-unity-font-style:bold;}
