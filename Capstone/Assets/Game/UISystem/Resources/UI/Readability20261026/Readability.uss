.readability-ui .companion-design .companion-embedded-skills .skills-learned-scroll {top:192px;height:217px;}
.readability-ui .companion-design .companion-embedded-skills .skills-filter-row {margin:0;padding:0;}
.readability-ui .companion-design .companion-embedded-skills .filter-rail-arrow {padding:0;margin:0;min-width:0;min-height:0;}
.readability-ui #quest-panel .quest-pill {background-color:transparent;color:#202B45;}
.readability-ui .bag-design .detail-badges Label {background-color:transparent;padding-left:0;margin-right:16px;}
.readability-ui .companion-design .companion-growth-heading>.companion-small-button Label {white-space:nowrap;}
.readability-ui .quest-tracker-title-background {display:none;}
.readability-ui .quest-tracker-title,.readability-ui .quest-tracker-objective,.readability-ui .quest-tracker-distance {color:#EDE9E1;background-color:transparent;}
.readability-ui .menu-theme {--menu-text:#202B45;--menu-muted:#39455E;--menu-border:#8996B0;--menu-surface:rgba(174,184,205,.48);--menu-title-color:#202B45;--menu-heading-accent:#CCAD83;--menu-back-text:#202B45;}
.readability-ui #box-panel,.readability-ui #codex-panel,.readability-ui #shop-panel,.readability-ui #settings-panel {background-color:#66748E;background-image:resource("UI/Unified20261024/Art/page");background-size:cover;}
.readability-ui .box-stat-cell,.readability-ui .box-skill-chip,.readability-ui .codex-type-badge,.readability-ui .codex-evolution-icon {background-color:transparent;border-width:0;}
.readability-ui .box-stat-name,.readability-ui .box-stat-value,.readability-ui .codex-type-badge {color:#202B45;}
.readability-ui .menu-save-indicator {background-color:transparent;color:#202B45;border-width:0;}
.readability-ui .ga-popup .ga-info-key,.readability-ui .ga-popup .ga-info-value,.readability-ui .ga-popup .pet-detail-stat-key,.readability-ui .ga-popup .pet-detail-stat-value,.readability-ui .ga-popup .ga-details-codex Label,.readability-ui .ga-popup #pet-details-ev-total {color:#202B45;}
/* Stronger, local reading role for transactional popups; no root/tree opacity. */
.readability-ui #level-up-modal-dialog .ga-info-key,.readability-ui #level-up-modal-dialog .ga-info-value,.readability-ui #heal-modal-dialog .ga-info-key,.readability-ui #heal-modal-dialog .ga-info-value {color:#152036;font-size:17px;}
.readability-ui #level-up-modal-dialog .ga-stat-key,.readability-ui #level-up-modal-dialog .ga-stat-value,.readability-ui #level-up-modal-dialog .level-up-stat-name,.readability-ui #level-up-modal-dialog .level-up-stat-value {color:#152036;font-size:18px;}
.readability-ui #level-up-modal-dialog .ga-level-stats Label {color:#152036;font-size:18px;}
.readability-ui #level-up-modal-dialog .ga-level-stats .ga-section-title {font-size:22px;-unity-font-style:bold;}
.readability-ui #level-up-modal-dialog .level-summary .ga-summary-meta Label {color:#152036;font-size:16px;}
.readability-ui #level-up-modal-dialog .ga-copy,.readability-ui #heal-modal-dialog .ga-copy,.readability-ui #heal-modal-dialog .ga-heal-values Label,.readability-ui #heal-modal-dialog .ga-heal-amount {font-size:18px;color:#152036;}
.readability-ui #level-up-modal-dialog .ga-level-new Label,.readability-ui #level-up-modal-dialog .ga-level-evolution Label {font-size:17px;color:#152036;}
.readability-ui #heal-modal-dialog .ga-item-name,.readability-ui #level-up-modal-dialog .ga-item-name {color:#152036;font-size:21px;}
.readability-ui #heal-modal-dialog .ga-item-count,.readability-ui #level-up-modal-dialog .ga-item-count {color:#152036;font-size:23px;}
.readability-ui #heal-modal-dialog .ga-heal-item-title,.readability-ui #heal-modal-dialog .ga-heal-feedback,.readability-ui #level-up-modal-dialog .ga-level-feedback {color:#152036;}
/* Growth modules are separate framed sections, rather than one continuous reading field. */
.readability-ui .companion-design .companion-growth-text {font-size:16px;}
.readability-ui .companion-design .companion-growth-reason {color:#39455E;}

/* Stable filter geometry: selection uses a brighter face AND a reserved checkmark. */
.readability-ui .skills-filter-button {position:relative;padding-left:24px;font-size:13px;}
.readability-ui .skills-filter-button .filter-selection-mark {position:absolute;left:7px;top:0;bottom:0;width:16px;font-size:14px;-unity-font-style:bold;-unity-text-align:middle-center;color:#202B45;}
.readability-ui .companion-design .skills-filter-button .angular-button-caption {left:22px;right:6px;color:#39455E;}
.readability-ui .companion-design .skills-filter-button.is-selected .angular-button-caption {color:#152036;-unity-font-style:bold;}
.readability-ui .skills-filter-button.is-selected {background-color:#C7C7E1;border-color:#CCAD83;color:#152036;}
.readability-ui .companion-design .skills-filter-button.is-selected {background-color:transparent;}
.readability-ui .companion-design .companion-embedded-skills .skills-filter-button {min-width:100px;}

/* Reading groups share the Quest/Growth frame, preserving local controls and scroll. */
.readability-ui .ui-copy-section {position:relative;flex-shrink:0;padding:14px;margin-bottom:12px;}
.readability-ui .ui-section-heading {font-size:18px;color:#202B45;-unity-font-style:bold;min-height:28px;margin-bottom:8px;border-bottom-width:1px;border-bottom-color:rgba(110,126,153,.4);}
.readability-ui .ui-copy-section Label {white-space:normal;}
.readability-ui #quest-panel .quest-detail-section.ui-section {padding:14px 18px;margin-top:14px;border-width:0;}
.readability-ui .companion-design .companion-summary.ui-section> #section-frame {left:-10px;right:-10px;top:-4px;bottom:-4px;}
.readability-ui .companion-design .companion-resources.ui-section> #section-frame {left:-8px;right:-8px;top:-4px;bottom:-4px;}
.readability-ui .companion-inline-detail.ui-section {padding:14px;}
.readability-ui .ga-popup .ui-section {color:#202B45;}
.readability-ui .ga-popup .ui-section .ga-section-title {color:#202B45;}
.readability-ui .ui-section .pet-detail-section-title,.readability-ui .ui-section .settings-section-title,.readability-ui .ui-section .codex-section-title {border-bottom-width:1px;border-bottom-color:rgba(110,126,153,.4);padding-bottom:6px;}
.readability-ui #box-panel .box-selected-meta-row.ui-section {padding:8px 12px;}
.readability-ui #box-panel .box-nature-card.ui-section,.readability-ui #box-panel .box-health-card.ui-section {padding:12px;}
.readability-ui #codex-panel .codex-progress.ui-section {padding:14px;}
.readability-ui #shop-panel .shop-purchase.ui-section {padding:14px;margin-top:12px;}
.readability-ui #settings-panel .settings-section-heading {background-color:transparent;}
.readability-ui #settings-panel .settings-note,.readability-ui #settings-panel .settings-section-title {color:#202B45;}
.readability-ui #release-modal-dialog .release-pet-card.ui-section,.readability-ui #release-modal-dialog .release-section.ui-section {padding:14px;margin-bottom:12px;}
.readability-ui #shop-panel .shop-subtitle,.readability-ui #codex-panel .codex-subtitle,.readability-ui #settings-panel .settings-subtitle {color:#202B45;}
.readability-ui #settings-panel .settings-row-label,.readability-ui #settings-panel .settings-percent {color:#202B45;}
