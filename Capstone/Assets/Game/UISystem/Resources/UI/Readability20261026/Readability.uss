.readability-ui .ga-popup .ga-details-advanced {height:auto;min-height:224px;flex-wrap:nowrap;flex-direction:column;padding:16px 20px;}
.readability-ui .ga-popup .ga-details-advanced>.ga-info-row {height:30px;width:100%;padding-right:0;}
.readability-ui .ga-popup .ga-details-advanced .ga-info-key,.readability-ui .ga-popup .ga-details-advanced .ga-info-value {font-size:18px;}
.readability-ui .genetics-table {height:100px;margin-top:10px;}
.readability-ui .genetics-row {flex-direction:row;height:30px;align-items:center;}
