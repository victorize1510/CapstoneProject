/* Runtime-only opt-in. Decorative text backplates never style input controls or selected buttons. */
.readability-ui .companion-design .companion-mode .companion-preview-toggle {width:128px;height:44px;margin:0;}
.readability-ui .companion-design .companion-preview-toggle .companion-icon {position:absolute;left:18px;top:12px;width:20px;height:20px;margin:0;}
