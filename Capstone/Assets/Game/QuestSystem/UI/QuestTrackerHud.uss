.quest-tracker-root {position:absolute;top:394px;left:24px;width:410px;max-height:200px;height:200px;}
.quest-tracker-scroll {flex-grow:1;min-height:0;padding:0;background-color:rgba(0,0,0,0);}
.quest-tracker-scroll .unity-scroll-view__content-container {padding:0;}
.quest-tracker-list {flex-grow:1;}
.quest-tracker-empty {display:none;}
.quest-tracker-card {position:relative;min-height:168px;max-height:200px;margin:0;padding:12px 16px;background-color:rgba(0,0,0,0);border-width:0;}
.quest-tracker-title-row {min-height:40px;max-height:68px;flex-direction:row;align-items:center;}
.quest-tracker-title {flex-grow:1;flex-shrink:1;margin-left:8px;font-size:26px;-unity-font-style:bold;white-space:normal;color:rgb(247,240,223);background-color:rgba(0,0,0,0);-unity-text-outline-width:1px;-unity-text-outline-color:rgb(23,39,47);}
.quest-tracker-objective {margin-top:6px;font-size:18px;color:rgb(247,240,223);white-space:normal;-unity-text-outline-width:1px;-unity-text-outline-color:rgb(23,39,47);}
.quest-tracker-progress-row {height:4px;margin-top:10px;flex-direction:row;}
.quest-tracker-progress-bar {flex-grow:1;height:3px;}
.quest-tracker-progress-bar .unity-progress-bar__background {background-color:rgba(23,39,47,.6);}
.quest-tracker-progress-bar .unity-progress-bar__progress {background-color:rgb(162,197,173);}
.quest-tracker-progress-bar .unity-progress-bar__title {display:none;}
.quest-tracker-distance {margin-top:12px;font-size:18px;color:rgb(247,240,223);white-space:normal;-unity-text-outline-width:1px;-unity-text-outline-color:rgb(23,39,47);}
.quest-tracker-progress-bar {min-height:3px;max-height:3px;padding:0;margin:0;border-width:0;background-color:rgba(23,39,47,.6);}
