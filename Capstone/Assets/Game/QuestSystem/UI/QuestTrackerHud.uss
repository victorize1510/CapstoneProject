.quest-tracker-root {
    position: absolute;
    top: 132px;
    left: 10px;
    width: 340px;
    height: 184px;
    max-height: 24%;
}

.quest-tracker-scroll {
    flex-grow: 1;
    min-height: 0;
    padding-left: 0;
    padding-right: 8px;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
}

.quest-tracker-scroll .unity-scroll-view__content-container {
    padding-left: 0;
    padding-right: 0;
}

.quest-tracker-scroll .unity-scroller {
    width: 4px;
    background-color: rgba(0, 0, 0, 0);
}

.quest-tracker-scroll .unity-scroller__slider {
    background-color: rgba(64, 101, 80, 0.28);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.quest-tracker-list {
    flex-grow: 1;
}

.quest-tracker-empty {
    display: none;
}

.quest-tracker-card {
    height: 148px;
    margin-bottom: 12px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.quest-tracker-card.is-tracked {
    border-left-color: rgba(0, 0, 0, 0);
}

.quest-tracker-title-row {
    height: 36px;
    flex-direction: row;
    align-items: stretch;
    position: relative;
}

.quest-tracker-title-background {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: row;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.quest-tracker-title-fade {
    flex-grow: 1;
}

.quest-tracker-title-fade-0 {
    background-color: rgba(244, 236, 211, 0.34);
}

.quest-tracker-title-fade-1 {
    background-color: rgba(244, 236, 211, 0.32);
}

.quest-tracker-title-fade-2 {
    background-color: rgba(244, 236, 211, 0.3);
}

.quest-tracker-title-fade-3 {
    background-color: rgba(244, 236, 211, 0.28);
}

.quest-tracker-title-fade-4 {
    background-color: rgba(244, 236, 211, 0.26);
}

.quest-tracker-title-fade-5 {
    background-color: rgba(244, 236, 211, 0.24);
}

.quest-tracker-title-fade-6 {
    background-color: rgba(244, 236, 211, 0.22);
}

.quest-tracker-title-fade-7 {
    background-color: rgba(244, 236, 211, 0.2);
}

.quest-tracker-title-fade-8 {
    background-color: rgba(244, 236, 211, 0.18);
}

.quest-tracker-title-fade-9 {
    background-color: rgba(244, 236, 211, 0.16);
}

.quest-tracker-title-fade-10 {
    background-color: rgba(244, 236, 211, 0.14);
}

.quest-tracker-title-fade-11 {
    background-color: rgba(244, 236, 211, 0.12);
}

.quest-tracker-title-fade-12 {
    background-color: rgba(244, 236, 211, 0.1);
}

.quest-tracker-title-fade-13 {
    background-color: rgba(244, 236, 211, 0.075);
}

.quest-tracker-title-fade-14 {
    background-color: rgba(244, 236, 211, 0.045);
}

.quest-tracker-title-fade-15 {
    background-color: rgba(244, 236, 211, 0.015);
}

.quest-tracker-title {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: rgb(6, 6, 5);
    background-color: rgba(0, 0, 0, 0);
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 5px;
    padding-bottom: 3px;
    font-size: 20px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-outline-width: 0;
    -unity-text-outline-color: rgba(0, 0, 0, 0);
}

.quest-tracker-objective {
    margin-top: 9px;
    padding-left: 10px;
    padding-right: 6px;
    color: rgb(8, 8, 7);
    font-size: 15px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-outline-width: 0;
    -unity-text-outline-color: rgba(0, 0, 0, 0);
}

.quest-tracker-progress-row {
    margin-top: 10px;
    margin-left: 10px;
    margin-right: 64px;
    flex-direction: row;
    align-items: center;
}

.quest-tracker-progress-bar {
    flex-grow: 1;
    height: 8px;
    margin-right: 0;
}

.quest-tracker-progress-bar .unity-progress-bar__background {
    background-color: rgba(28, 31, 26, 0.18);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.quest-tracker-progress-bar .unity-progress-bar__progress {
    background-color: rgba(45, 128, 101, 0.9);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.quest-tracker-distance {
    margin-top: 14px;
    padding-left: 10px;
    padding-right: 6px;
    color: rgb(8, 8, 7);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-outline-width: 0;
    -unity-text-outline-color: rgba(0, 0, 0, 0);
}
