.inventory-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 19, 22, 0.62);
    color: #2f2a20;
}

.menu-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(12, 22, 24, 0.38);
}

.menu-top-hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: 86px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(20, 64, 70, 0.86);
    border-bottom-width: 2px;
    border-bottom-color: rgba(203, 177, 111, 0.82);
    padding-left: 14px;
    padding-right: 14px;
}

.player-hud {
    width: 270px;
    min-width: 220px;
    flex-shrink: 1;
    flex-direction: row;
    align-items: center;
}

.player-emblem {
    width: 56px;
    height: 56px;
    align-items: center;
    justify-content: center;
    background-color: rgba(42, 82, 70, 0.95);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: #d4bc75;
    border-right-color: #d4bc75;
    border-top-color: #d4bc75;
    border-bottom-color: #d4bc75;
    border-top-left-radius: 28px;
    border-top-right-radius: 28px;
    border-bottom-left-radius: 28px;
    border-bottom-right-radius: 28px;
}

.player-emblem-mark {
    color: #f5e8c8;
    font-size: 18px;
    -unity-font-style: bold;
}

.player-stat-stack {
    flex-grow: 1;
    min-width: 0;
    margin-left: 12px;
}

.hud-level-label {
    height: 22px;
    color: #fbefd0;
    font-size: 16px;
    -unity-font-style: bold;
}

.hud-bar-row {
    height: 22px;
    flex-direction: row;
    align-items: center;
}

.hud-bar-caption {
    width: 30px;
    font-size: 11px;
    -unity-font-style: bold;
}

.hp-caption {
    color: #9ff0bd;
}

.exp-caption {
    color: #8cc8ff;
}

.hud-bar {
    flex-grow: 1;
    height: 9px;
    margin-right: 8px;
}

.hud-bar .unity-progress-bar__background {
    background-color: rgba(7, 16, 18, 0.72);
}

.hp-bar .unity-progress-bar__progress {
    background-color: #42d7a0;
}

.exp-bar .unity-progress-bar__progress {
    background-color: #4aa0e6;
}

.hud-bar-value {
    width: 70px;
    font-size: 10px;
    color: #f4e6c4;
    -unity-text-align: middle-right;
}

.menu-nav {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 54px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.keycap {
    min-width: 30px;
    height: 30px;
    padding-left: 8px;
    padding-right: 8px;
    -unity-text-align: middle-center;
    color: #f8edcd;
    background-color: rgba(23, 42, 40, 0.88);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #cdb67c;
    border-right-color: #cdb67c;
    border-top-color: #cdb67c;
    border-bottom-color: #cdb67c;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    font-size: 14px;
    -unity-font-style: bold;
}

.nav-keycap {
    margin-left: 4px;
    margin-right: 4px;
}

.nav-button,
.nav-icon-button {
    height: 42px;
    margin-left: 3px;
    margin-right: 3px;
    color: #f6e9c7;
    background-color: rgba(29, 67, 68, 0.9);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(198, 172, 104, 0.72);
    border-right-color: rgba(198, 172, 104, 0.72);
    border-top-color: rgba(198, 172, 104, 0.72);
    border-bottom-color: rgba(198, 172, 104, 0.72);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    font-size: 14px;
    -unity-font-style: bold;
}

.nav-button {
    width: 112px;
}

.nav-icon-button {
    width: 76px;
    font-size: 11px;
}

.nav-selected {
    background-color: rgba(49, 90, 72, 0.96);
    border-left-color: #f0d078;
    border-right-color: #f0d078;
    border-top-color: #f0d078;
    border-bottom-color: #f0d078;
}

.disabled-nav {
    opacity: 0.58;
}

.currency-hud {
    width: 220px;
    min-width: 170px;
    flex-shrink: 1;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

.currency-chip {
    height: 36px;
    flex-direction: row;
    align-items: center;
    margin-left: 7px;
}

.currency-icon {
    width: 24px;
    height: 24px;
    margin-right: 6px;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-left-radius: 15px;
    border-bottom-right-radius: 15px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}

.gold-icon {
    background-color: #d6a84b;
    border-left-color: #f6df8a;
    border-right-color: #f6df8a;
    border-top-color: #f6df8a;
    border-bottom-color: #f6df8a;
}

.gem-icon {
    background-color: #4fb4e8;
    border-left-color: #b9ecff;
    border-right-color: #b9ecff;
    border-top-color: #b9ecff;
    border-bottom-color: #b9ecff;
}

.currency-value {
    color: #f9eecf;
    font-size: 14px;
    -unity-font-style: bold;
}

.plus-button {
    width: 30px;
    height: 30px;
    margin-left: 8px;
    color: #f9eecf;
    background-color: rgba(23, 42, 40, 0.9);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #cdb67c;
    border-right-color: #cdb67c;
    border-top-color: #cdb67c;
    border-bottom-color: #cdb67c;
    border-top-left-radius: 17px;
    border-top-right-radius: 17px;
    border-bottom-left-radius: 17px;
    border-bottom-right-radius: 17px;
    font-size: 20px;
    -unity-font-style: bold;
}

.quest-inventory-shell {
    position: absolute;
    left: 2%;
    top: 98px;
    right: 2%;
    bottom: 76px;
    width: auto;
    height: auto;
    max-width: 1760px;
    min-width: 0;
    min-height: 0;
    flex-direction: row;
    margin-top: 0;
}

.menu-panel,
.inventory-shell {
    background-color: #efe2c4;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: #a88e58;
    border-right-color: #a88e58;
    border-top-color: #a88e58;
    border-bottom-color: #a88e58;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.quest-panel {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 340px;
    margin-right: 10px;
}

.inventory-panel {
    flex-grow: 2;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
}

.inventory-shell {
    width: 100%;
    height: 100%;
    flex-direction: column;
}

.panel-title-row {
    height: 56px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(246, 236, 211, 0.96);
    border-bottom-width: 1px;
    border-bottom-color: rgba(161, 136, 83, 0.55);
    padding-left: 16px;
    padding-right: 16px;
}

.inventory-title-row {
    justify-content: flex-start;
}

.panel-title {
    flex-grow: 1;
    color: #3b3325;
    font-size: 23px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.header-meta {
    width: 96px;
    flex-direction: column;
    align-items: flex-end;
}

.meta-caption {
    color: #746742;
    font-size: 10px;
}

.meta-value {
    color: #3b3325;
    font-size: 18px;
    -unity-font-style: bold;
}

.quest-content {
    flex-grow: 1;
    min-height: 0;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
}

.quest-tab-row {
    height: 40px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.side-keycap {
    width: 30px;
    min-width: 30px;
    height: 30px;
    margin-left: 4px;
    margin-right: 4px;
    color: #3b3325;
    background-color: rgba(242, 231, 203, 0.95);
}

.quest-tabs {
    flex-grow: 1;
    min-width: 0;
    flex-direction: row;
}

.quest-tab {
    flex-grow: 1;
    height: 34px;
    margin-left: 4px;
    margin-right: 4px;
    color: #4e4433;
    background-color: #e1d4b6;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #ac9562;
    border-right-color: #ac9562;
    border-top-color: #ac9562;
    border-bottom-color: #ac9562;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
    font-size: 12px;
    -unity-font-style: bold;
}

.quest-tab:hover {
    background-color: #eaddbe;
}

.quest-tab.is-selected {
    color: #fbefd0;
    background-color: #267154;
    border-left-color: #d8bf76;
    border-right-color: #d8bf76;
    border-top-color: #d8bf76;
    border-bottom-color: #d8bf76;
}

.quest-main-grid {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
}

.quest-list-column {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 160px;
    margin-right: 8px;
}

.quest-list-scroll {
    flex-grow: 1;
    min-height: 0;
    background-color: rgba(251, 244, 224, 0.78);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(169, 144, 91, 0.48);
    border-right-color: rgba(169, 144, 91, 0.48);
    border-top-color: rgba(169, 144, 91, 0.48);
    border-bottom-color: rgba(169, 144, 91, 0.48);
}

.quest-empty-label {
    flex-grow: 1;
    -unity-text-align: middle-center;
    color: #7c6b45;
    font-size: 15px;
    -unity-font-style: bold;
    background-color: rgba(251, 244, 224, 0.78);
}

.quest-card {
    min-height: 62px;
    background-color: rgba(246, 237, 214, 0.92);
    border-bottom-width: 1px;
    border-bottom-color: rgba(166, 142, 91, 0.38);
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.quest-card:hover {
    background-color: #f3e4bf;
}

.quest-card.is-selected {
    background-color: #dbeac6;
    border-left-width: 4px;
    border-left-color: #2f8a63;
}

.quest-card.is-tracked {
    border-right-width: 3px;
    border-right-color: #d2a84d;
}

.quest-card-title {
    color: #2f2a20;
    font-size: 14px;
    -unity-font-style: bold;
    white-space: normal;
}

.quest-card-meta,
.quest-card-status {
    color: #756846;
    font-size: 11px;
    margin-top: 2px;
}

.quest-card-status {
    -unity-font-style: bold;
    color: #2f7556;
}

.quest-sort-row {
    height: 42px;
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
}

.sort-label {
    flex-grow: 1;
    height: 32px;
    padding-left: 10px;
    padding-top: 6px;
    color: #4d422f;
    background-color: rgba(250, 241, 219, 0.72);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(166, 142, 91, 0.5);
    border-right-color: rgba(166, 142, 91, 0.5);
    border-top-color: rgba(166, 142, 91, 0.5);
    border-bottom-color: rgba(166, 142, 91, 0.5);
    font-size: 12px;
}

.small-square-button {
    width: 56px;
    height: 32px;
    margin-left: 8px;
    color: #4d422f;
    background-color: #dfd2b1;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #a8905a;
    border-right-color: #a8905a;
    border-top-color: #a8905a;
    border-bottom-color: #a8905a;
}

.quest-detail-scroll {
    flex-grow: 1.35;
    flex-basis: 0;
    min-width: 190px;
    min-height: 0;
    background-color: rgba(251, 244, 224, 0.8);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(169, 144, 91, 0.48);
    border-right-color: rgba(169, 144, 91, 0.48);
    border-top-color: rgba(169, 144, 91, 0.48);
    border-bottom-color: rgba(169, 144, 91, 0.48);
}

.quest-detail-panel {
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 14px;
    padding-bottom: 14px;
}

.quest-detail-heading-row {
    min-height: 78px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.quest-banner-icon {
    width: 46px;
    height: 58px;
    flex-shrink: 0;
    background-color: #2f7556;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #d7bd74;
    border-right-color: #d7bd74;
    border-top-color: #d7bd74;
    border-bottom-color: #d7bd74;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.quest-detail-heading-text {
    flex-grow: 1;
    min-width: 0;
    margin-left: 10px;
}

.quest-detail-title {
    color: #2f2a20;
    font-size: 18px;
    -unity-font-style: bold;
    white-space: normal;
}

.quest-location-title {
    color: #6e6245;
    font-size: 13px;
    margin-top: 4px;
}

.quest-detail-meta-row {
    flex-direction: row;
    margin-bottom: 10px;
}

.quest-pill {
    min-height: 24px;
    margin-right: 6px;
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 4px;
    color: #f9edd0;
    background-color: #53734f;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    font-size: 11px;
    -unity-font-style: bold;
}

.quest-description,
.objective-text,
.reward-text {
    color: #3f3728;
    font-size: 13px;
    white-space: normal;
}

.quest-description {
    margin-bottom: 12px;
}

.quest-section-title,
.detail-section-title,
.effect-title {
    color: #2f7556;
    font-size: 13px;
    -unity-font-style: bold;
    margin-top: 8px;
    margin-bottom: 6px;
}

.objective-list {
    background-color: rgba(233, 222, 192, 0.58);
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 4px;
}

.objective-row {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 7px;
}

.objective-bullet {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    margin-right: 8px;
    -unity-text-align: middle-center;
    color: #fbefd0;
    background-color: #3a8c64;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    font-size: 11px;
    -unity-font-style: bold;
}

.quest-progress-row {
    height: 24px;
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
}

.quest-progress-label {
    flex-grow: 1;
    color: #2f7556;
    font-size: 12px;
    -unity-font-style: bold;
}

.quest-progress-value {
    width: 68px;
    color: #3f3728;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.quest-progress-bar {
    height: 14px;
    margin-bottom: 8px;
}

.quest-progress-bar .unity-progress-bar__background,
.item-list .unity-list-view__item {
    background-color: rgba(71, 62, 42, 0.16);
}

.quest-progress-bar .unity-progress-bar__progress {
    background-color: #3a8c64;
}

.quest-state-grid {
    background-color: rgba(233, 222, 192, 0.5);
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 6px;
}

.quest-state-row {
    min-height: 22px;
    flex-direction: row;
}

.hidden-state-row {
    display: none;
}

.quest-state-label {
    width: 82px;
    color: #746742;
    font-size: 11px;
}

.quest-state-value {
    flex-grow: 1;
    min-width: 0;
    color: #3f3728;
    font-size: 12px;
    -unity-font-style: bold;
    white-space: normal;
}

.reward-list {
    flex-direction: row;
    flex-wrap: wrap;
}

.reward-row {
    width: 112px;
    min-height: 38px;
    flex-direction: row;
    align-items: center;
    margin-right: 7px;
    margin-bottom: 7px;
    background-color: rgba(224, 209, 173, 0.78);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #a8905a;
    border-right-color: #a8905a;
    border-top-color: #a8905a;
    border-bottom-color: #a8905a;
}

.reward-icon {
    width: 30px;
    height: 30px;
    margin-left: 4px;
    margin-right: 6px;
    background-color: #bf9943;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.quest-actions {
    height: 46px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    margin-top: 10px;
}

.quest-action-button,
.action-button {
    height: 36px;
    min-width: 82px;
    margin-left: 6px;
    color: #f8edcd;
    background-color: #53734f;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #8fa96c;
    border-right-color: #8fa96c;
    border-top-color: #8fa96c;
    border-bottom-color: #8fa96c;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
    font-size: 13px;
    -unity-font-style: bold;
}

.quest-action-button:hover,
.action-button:hover {
    background-color: #63865b;
}

.quest-action-button:disabled,
.action-button:disabled {
    color: #938874;
    background-color: #d1c4a5;
    border-left-color: #b8a270;
    border-right-color: #b8a270;
    border-top-color: #b8a270;
    border-bottom-color: #b8a270;
}

.primary-quest-action,
.primary-action {
    background-color: #267154;
    border-left-color: #78b884;
    border-right-color: #78b884;
    border-top-color: #78b884;
    border-bottom-color: #78b884;
}

.blue-action {
    background-color: #386d86;
    border-left-color: #85b7ca;
    border-right-color: #85b7ca;
    border-top-color: #85b7ca;
    border-bottom-color: #85b7ca;
}

.gold-action {
    background-color: #8a6731;
    border-left-color: #d1b56f;
    border-right-color: #d1b56f;
    border-top-color: #d1b56f;
    border-bottom-color: #d1b56f;
}

.danger-action,
.danger-quest-action {
    background-color: #7a4f39;
    border-left-color: #c28a6c;
    border-right-color: #c28a6c;
    border-top-color: #c28a6c;
    border-bottom-color: #c28a6c;
}

.back-action {
    background-color: #4a4d47;
    border-left-color: #9d9a84;
    border-right-color: #9d9a84;
    border-top-color: #9d9a84;
    border-bottom-color: #9d9a84;
}

.inventory-body {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
}

.category-panel {
    flex-grow: 0;
    flex-shrink: 0;
    width: 132px;
    min-width: 118px;
    background-color: rgba(238, 226, 197, 0.88);
    border-right-width: 1px;
    border-right-color: rgba(169, 144, 91, 0.48);
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 16px;
    padding-bottom: 12px;
}

.category-button {
    height: 38px;
    margin-bottom: 8px;
    color: #4a412f;
    background-color: rgba(226, 211, 177, 0.85);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #ad9561;
    border-right-color: #ad9561;
    border-top-color: #ad9561;
    border-bottom-color: #ad9561;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
    font-size: 12px;
    -unity-font-style: bold;
}

.category-button:hover {
    background-color: #eadcba;
}

.category-button.is-selected {
    color: #fbefd0;
    background-color: #267154;
    border-left-color: #d8bf76;
    border-right-color: #d8bf76;
    border-top-color: #d8bf76;
    border-bottom-color: #d8bf76;
}

.capacity-chip {
    height: 40px;
    margin-top: 18px;
    flex-direction: row;
    align-items: center;
}

.capacity-caption,
.capacity-text {
    color: #5e5137;
    font-size: 12px;
}

.capacity-text {
    flex-grow: 1;
    -unity-text-align: middle-right;
    -unity-font-style: bold;
}

.list-panel {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 210px;
    background-color: rgba(250, 241, 219, 0.82);
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 12px;
    padding-bottom: 12px;
}

.item-list {
    flex-grow: 1;
    background-color: rgba(251, 244, 224, 0.78);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(169, 144, 91, 0.48);
    border-right-color: rgba(169, 144, 91, 0.48);
    border-top-color: rgba(169, 144, 91, 0.48);
    border-bottom-color: rgba(169, 144, 91, 0.48);
}

.no-items-label {
    flex-grow: 1;
    -unity-text-align: middle-center;
    color: #7c6b45;
    font-size: 22px;
    -unity-font-style: bold;
    background-color: rgba(251, 244, 224, 0.78);
}

.item-row {
    height: 62px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(246, 237, 214, 0.92);
    border-bottom-width: 1px;
    border-bottom-color: rgba(166, 142, 91, 0.38);
    padding-left: 8px;
    padding-right: 8px;
}

.item-row:hover {
    background-color: #f3e4bf;
}

.item-list .unity-list-view__item--selected,
.item-list .unity-list-view__item--selected:hover,
.item-list .unity-list-view__item--selected .item-row,
.item-list .unity-list-view__item--selected .item-row:hover {
    background-color: #dbeac6;
}

.inventory-root.keyboard-navigation .item-row:hover {
    background-color: rgba(246, 237, 214, 0.92);
}

.item-row-icon {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    background-color: #a49268;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #d7bd74;
    border-right-color: #d7bd74;
    border-top-color: #d7bd74;
    border-bottom-color: #d7bd74;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.item-row-text {
    flex-grow: 1;
    min-width: 0;
    margin-left: 9px;
}

.item-row-name {
    color: #2f2a20;
    font-size: 14px;
    -unity-font-style: bold;
}

.item-row-category {
    color: #746742;
    font-size: 11px;
}

.item-row-quantity {
    width: 44px;
    color: #3e3527;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.detail-panel {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 230px;
    background-color: rgba(246, 237, 214, 0.92);
    border-left-width: 1px;
    border-left-color: rgba(169, 144, 91, 0.48);
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 16px;
    padding-bottom: 16px;
}

.detail-name {
    min-height: 42px;
    color: #267154;
    background-color: rgba(228, 213, 177, 0.72);
    -unity-text-align: middle-center;
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 14px;
}

.detail-icon {
    width: 108px;
    height: 108px;
    align-self: center;
    background-color: #7d8b5e;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: #cbb783;
    border-right-color: #cbb783;
    border-top-color: #cbb783;
    border-bottom-color: #cbb783;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    margin-bottom: 18px;
}

.detail-info-grid {
    min-height: 56px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(169, 144, 91, 0.36);
    border-bottom-color: rgba(169, 144, 91, 0.36);
    padding-top: 7px;
    padding-bottom: 7px;
}

.detail-line,
.detail-description,
.effect-text {
    color: #3f3728;
    font-size: 14px;
    white-space: normal;
}

.detail-line {
    margin-bottom: 5px;
}

.detail-description {
    min-height: 74px;
    margin-bottom: 12px;
}

.effect-box {
    flex-grow: 1;
    min-height: 86px;
    background-color: #e3d7b6;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(169, 144, 91, 0.48);
    border-right-color: rgba(169, 144, 91, 0.48);
    border-top-color: rgba(169, 144, 91, 0.48);
    border-bottom-color: rgba(169, 144, 91, 0.48);
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 12px;
    padding-bottom: 12px;
}

.inventory-footer {
    height: 58px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    background-color: rgba(235, 222, 192, 0.96);
    border-top-width: 1px;
    border-top-color: rgba(161, 136, 83, 0.55);
    padding-left: 12px;
    padding-right: 12px;
}

.action-button {
    width: 90px;
}

.bottom-hint {
    position: absolute;
    bottom: 14px;
    height: 44px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(24, 42, 38, 0.88);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(207, 183, 118, 0.7);
    border-right-color: rgba(207, 183, 118, 0.7);
    border-top-color: rgba(207, 183, 118, 0.7);
    border-bottom-color: rgba(207, 183, 118, 0.7);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-left: 16px;
    padding-right: 16px;
}

.bottom-keycap {
    min-width: 48px;
    height: 34px;
}

.hint-divider {
    color: #f8edcd;
    margin-left: 12px;
    margin-right: 12px;
    font-size: 18px;
}

.hint-text {
    color: #f8edcd;
    font-size: 17px;
    margin-left: 14px;
}

.quantity-popup-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(11, 18, 18, 0.58);
}

.quantity-popup-panel {
    width: 420px;
    min-height: 450px;
    align-items: center;
    background-color: #efe2c4;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: #a88e58;
    border-right-color: #a88e58;
    border-top-color: #a88e58;
    border-bottom-color: #a88e58;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 22px;
    padding-bottom: 22px;
}

.quantity-popup-title {
    color: #2f2a20;
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.quantity-popup-icon {
    width: 92px;
    height: 92px;
    background-color: #7d8b5e;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: #cbb783;
    border-right-color: #cbb783;
    border-top-color: #cbb783;
    border-bottom-color: #cbb783;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
    margin-bottom: 12px;
}

.quantity-popup-item-name {
    width: 100%;
    color: #2f2a20;
    font-size: 21px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 6px;
}

.quantity-popup-owned {
    color: #746742;
    font-size: 15px;
    -unity-text-align: middle-center;
    margin-bottom: 18px;
}

.quantity-stepper {
    width: 100%;
    height: 46px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
}

.quantity-step-button {
    width: 46px;
    height: 42px;
    color: #f8edcd;
    background-color: #53734f;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #8fa96c;
    border-right-color: #8fa96c;
    border-top-color: #8fa96c;
    border-bottom-color: #8fa96c;
    font-size: 21px;
    -unity-font-style: bold;
}

.quantity-field {
    flex-grow: 1;
    height: 42px;
    margin-left: 10px;
    margin-right: 10px;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.quantity-slider {
    width: 100%;
    margin-bottom: 12px;
}

.quantity-quick-row {
    width: 100%;
    height: 38px;
    flex-direction: row;
    margin-bottom: 24px;
}

.quantity-quick-button {
    flex-grow: 1;
    height: 34px;
    margin-left: 4px;
    margin-right: 4px;
    color: #4a412f;
    background-color: #e1d4b6;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #ad9561;
    border-right-color: #ad9561;
    border-top-color: #ad9561;
    border-bottom-color: #ad9561;
    font-size: 14px;
    -unity-font-style: bold;
}

.quantity-action-row {
    width: 100%;
    height: 44px;
    flex-direction: row;
    justify-content: center;
}

.quantity-confirm-button,
.quantity-cancel-button {
    width: 140px;
    height: 42px;
    margin-left: 8px;
    margin-right: 8px;
    color: #f8edcd;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    font-size: 16px;
    -unity-font-style: bold;
}

.quantity-confirm-button {
    background-color: #267154;
    border-left-color: #78b884;
    border-right-color: #78b884;
    border-top-color: #78b884;
    border-bottom-color: #78b884;
}

.quantity-cancel-button {
    background-color: #4a4d47;
    border-left-color: #9d9a84;
    border-right-color: #9d9a84;
    border-top-color: #9d9a84;
    border-bottom-color: #9d9a84;
}
