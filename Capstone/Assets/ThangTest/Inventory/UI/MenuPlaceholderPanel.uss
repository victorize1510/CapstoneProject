/* Panel-specific overrides for MenuPlaceholderPanel.
   Keep shared legacy rules in MonsterInventory.uss until they are migrated safely. */

/* Keeps unfinished feature screens visible while they are edited standalone. */
.menu-placeholder-panel {
    display: flex;
    width: 100%;
    height: 100%;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}
