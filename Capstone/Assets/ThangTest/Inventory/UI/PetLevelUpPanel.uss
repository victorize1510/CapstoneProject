.level-up-modal-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
}

.level-up-modal-dim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(8, 22, 18, 0.66);
}

.level-up-modal-dialog {
    width: 72%;
    height: 94%;
    min-width: 840px;
    min-height: 620px;
    max-width: 1160px;
    max-height: 1010px;
    background-color: rgb(253, 252, 247);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(121, 156, 100);
    border-right-color: rgb(121, 156, 100);
    border-top-color: rgb(121, 156, 100);
    border-bottom-color: rgb(121, 156, 100);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.level-up-header {
    height: 70px;
    min-height: 70px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-bottom-width: 1px;
    border-bottom-color: rgb(207, 218, 199);
}

.level-up-title {
    margin-left: 16px;
    margin-right: 16px;
    color: rgb(50, 104, 45);
    font-size: 34px;
    -unity-font-style: bold;
}

.level-up-ornament {
    color: rgb(121, 171, 91);
    font-size: 28px;
}

.level-up-ornament.mirrored { rotate: 180deg; }

.level-up-close-button {
    position: absolute;
    right: 10px;
    top: 10px;
    width: 48px;
    height: 48px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 4px;
    color: rgb(43, 82, 45);
    background-color: rgb(253, 252, 247);
    border-left-color: rgb(165, 184, 154);
    border-right-color: rgb(165, 184, 154);
    border-top-color: rgb(165, 184, 154);
    border-bottom-color: rgb(165, 184, 154);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    font-size: 36px;
}

.level-up-close-button:hover { background-color: rgb(233, 244, 226); }

.level-up-scroll { flex-grow: 1; padding: 14px 18px 10px 18px; }

.level-up-summary-card,
.level-up-stats-card,
.level-up-secondary-card {
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(176, 195, 163);
    border-right-color: rgb(176, 195, 163);
    border-top-color: rgb(176, 195, 163);
    border-bottom-color: rgb(176, 195, 163);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: rgb(255, 255, 252);
}

.level-up-summary-card {
    min-height: 188px;
    flex-direction: row;
    padding: 12px;
}

.level-up-pet-portrait {
    width: 176px;
    min-width: 176px;
    height: 160px;
    align-items: center;
    justify-content: center;
    background-color: rgb(232, 243, 224);
    -unity-background-scale-mode: scale-to-fit;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.level-up-portrait-fallback,
.level-up-icon-fallback { color: rgb(73, 132, 61); font-size: 28px; -unity-font-style: bold; }

.level-up-identity-column {
    width: 31%;
    min-width: 210px;
    padding-left: 20px;
    padding-top: 10px;
}

.level-up-pet-name { color: rgb(48, 104, 45); font-size: 27px; -unity-font-style: bold; margin-bottom: 12px; }
.level-up-info-row { height: 32px; flex-direction: row; align-items: center; }
.level-up-info-key { width: 76px; color: rgb(53, 64, 55); font-size: 14px; }
.level-up-info-value { color: rgb(28, 43, 32); font-size: 15px; -unity-font-style: bold; }
.level-up-info-value.accent { color: rgb(64, 132, 54); }
.level-up-info-value.rarity { color: rgb(184, 134, 35); }

.level-up-progress-column { flex-grow: 1; padding-left: 14px; padding-right: 8px; padding-top: 9px; }
.level-up-level-row { height: 54px; flex-direction: row; align-items: center; justify-content: center; }
.level-up-current-level { color: rgb(32, 39, 34); font-size: 27px; -unity-font-style: bold; }
.level-up-level-arrow { margin-left: 18px; margin-right: 18px; color: rgb(82, 116, 65); font-size: 32px; -unity-font-style: bold; }
.level-up-next-level { color: rgb(45, 122, 42); font-size: 28px; -unity-font-style: bold; }
.level-up-max-label { display: none; color: rgb(180, 132, 36); font-size: 22px; -unity-font-style: bold; }

.level-up-bar-row { height: 38px; flex-direction: row; align-items: center; }
.level-up-bar-row.health-row { margin-top: 4px; }
.level-up-bar-label { width: 48px; color: rgb(42, 63, 47); font-size: 15px; -unity-font-style: bold; }
.level-up-bar-track { flex-grow: 1; height: 13px; background-color: rgb(224, 228, 218); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-left-radius: 6px; border-bottom-right-radius: 6px; overflow: hidden; }
.level-up-bar-fill { height: 100%; width: 0%; }
.level-up-bar-fill.exp { background-color: rgb(55, 146, 97); }
.level-up-bar-fill.health { background-color: rgb(100, 165, 72); }
.level-up-bar-value { width: 112px; margin-left: 10px; color: rgb(35, 48, 39); font-size: 13px; -unity-text-align: middle-right; }
.level-up-exp-needed { height: 22px; margin-right: 112px; color: rgb(92, 107, 84); font-size: 12px; -unity-text-align: middle-right; }

.level-up-stats-card { min-height: 205px; margin-top: 12px; padding: 8px 16px 12px 16px; }
.level-up-section-title { height: 36px; color: rgb(53, 105, 48); font-size: 18px; -unity-font-style: bold; -unity-text-align: middle-center; border-bottom-width: 1px; border-bottom-color: rgb(221, 227, 215); }
.level-up-stat-header,
.level-up-stat-row { height: 33px; flex-direction: row; align-items: center; padding-left: 16px; padding-right: 16px; }
.level-up-stat-row.alt { background-color: rgb(246, 249, 241); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; }
.level-up-stat-name { width: 27%; color: rgb(39, 51, 42); font-size: 15px; -unity-font-style: bold; }
.level-up-stat-number { width: 23%; color: rgb(39, 51, 42); font-size: 15px; -unity-text-align: middle-center; }
.level-up-stat-number.next { color: rgb(39, 128, 40); -unity-font-style: bold; }
.level-up-stat-arrow { width: 8%; color: rgb(101, 119, 91); font-size: 19px; -unity-text-align: middle-center; }
.level-up-stat-delta { width: 19%; color: rgb(42, 137, 42); font-size: 15px; -unity-font-style: bold; -unity-text-align: middle-center; }

.level-up-secondary-row { min-height: 150px; margin-top: 12px; flex-direction: row; }
.level-up-secondary-card { flex-grow: 1; min-width: 0; padding: 7px 14px 12px 14px; }
.level-up-evolution-section { margin-left: 10px; }
.level-up-new-skill-section { display: none; }
.level-up-skill-content,
.level-up-evolution-content { flex-grow: 1; min-height: 92px; flex-direction: row; align-items: center; justify-content: center; }
.level-up-skill-icon,
.level-up-evolution-icon,
.level-up-item-icon { align-items: center; justify-content: center; background-color: rgb(225, 241, 217); -unity-background-scale-mode: scale-to-fit; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-left-radius: 5px; border-bottom-right-radius: 5px; }
.level-up-skill-icon { width: 74px; min-width: 74px; height: 74px; }
.level-up-skill-copy { flex-grow: 1; padding-left: 14px; }
.level-up-skill-name { color: rgb(38, 54, 42); font-size: 16px; -unity-font-style: bold; }
.level-up-skill-description { margin-top: 5px; color: rgb(67, 78, 68); font-size: 12px; white-space: normal; }
.level-up-skill-unlock { margin-top: 6px; color: rgb(49, 137, 45); font-size: 12px; -unity-font-style: bold; }
.level-up-evolution-icon { width: 72px; min-width: 72px; height: 72px; }
.level-up-evolution-arrow { margin-left: 12px; margin-right: 12px; color: rgb(52, 125, 49); font-size: 27px; -unity-font-style: bold; }
.level-up-evolution-copy { flex-grow: 1; min-width: 190px; padding-left: 12px; }
.level-up-evolution-state { color: rgb(41, 112, 42); font-size: 15px; -unity-font-style: bold; white-space: normal; }
.level-up-evolution-requirement { margin-top: 5px; color: rgb(67, 78, 68); font-size: 12px; }
.level-up-evolution-button { height: 30px; margin-top: 6px; color: white; background-color: rgb(58, 133, 50); border-left-color: rgb(43, 103, 38); border-right-color: rgb(43, 103, 38); border-top-color: rgb(43, 103, 38); border-bottom-color: rgb(43, 103, 38); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; -unity-font-style: bold; }

.level-up-footer { height: 118px; min-height: 118px; margin-left: 18px; margin-right: 18px; padding-top: 8px; flex-direction: row; border-top-width: 1px; border-top-color: rgb(202, 216, 193); }
.level-up-item-area { width: 45%; }
.level-up-footer-title { color: rgb(53, 105, 48); font-size: 15px; -unity-font-style: bold; }
.level-up-item-card { height: 72px; margin-top: 5px; flex-direction: row; align-items: center; }
.level-up-item-icon { width: 66px; min-width: 66px; height: 66px; margin-right: 12px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(153, 181, 139); border-right-color: rgb(153, 181, 139); border-top-color: rgb(153, 181, 139); border-bottom-color: rgb(153, 181, 139); }
.level-up-item-name { color: rgb(35, 48, 39); font-size: 15px; -unity-font-style: bold; }
.level-up-item-count { margin-top: 5px; color: rgb(48, 128, 45); font-size: 17px; -unity-font-style: bold; }
.level-up-item-count.is-missing { color: rgb(175, 77, 60); }
.level-up-action-area { flex-grow: 1; align-items: center; justify-content: center; }
.level-up-feedback { height: 24px; color: rgb(151, 69, 53); font-size: 12px; -unity-text-align: middle-center; }
.level-up-confirm-button { width: 330px; height: 62px; color: white; background-color: rgb(69, 145, 51); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(157, 126, 55); border-right-color: rgb(157, 126, 55); border-top-color: rgb(157, 126, 55); border-bottom-color: rgb(157, 126, 55); border-top-left-radius: 7px; border-top-right-radius: 7px; border-bottom-left-radius: 7px; border-bottom-right-radius: 7px; font-size: 24px; -unity-font-style: bold; }
.level-up-confirm-button:hover { background-color: rgb(82, 162, 59); }
.level-up-confirm-button:disabled { color: rgb(142, 147, 138); background-color: rgb(219, 223, 215); border-left-color: rgb(188, 191, 184); border-right-color: rgb(188, 191, 184); border-top-color: rgb(188, 191, 184); border-bottom-color: rgb(188, 191, 184); }
