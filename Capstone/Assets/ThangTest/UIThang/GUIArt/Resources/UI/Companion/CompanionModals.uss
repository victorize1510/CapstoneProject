/* Applies only while the companion UI owns the inventory document. */
.companion-context #level-up-modal-dialog, .companion-context #heal-modal-dialog, .companion-context #evolution-modal-content { background-color:#91afb6; background-image:none; border-color:#c4af83; }
.companion-context .level-up-pet-card, .companion-context .level-up-item-card, .companion-context .level-up-preview-section, .companion-context .heal-pet-card, .companion-context .heal-item-card, .companion-context .heal-preview-section, .companion-context .evolution-dialogue-box { background-color:#a2c0c6; background-image:none; border-color:#86a9b0; }
.companion-context #heal-modal-dialog Label, .companion-context #level-up-modal-dialog Label, .companion-context #evolution-modal-content Label { color:#183747; }
.companion-context #heal-confirm-button, .companion-context #level-up-confirm-button, .companion-context #evolution-confirm-button, .companion-context #pets-rename-save { background-image:url('Components/button_primary.png'); background-color:transparent; border-width:0; -unity-slice-left:24; -unity-slice-top:24; -unity-slice-right:24; -unity-slice-bottom:24; color:#edf1e3; font-size:18px; -unity-font-style:bold; }
.companion-context #heal-confirm-button:disabled, .companion-context #level-up-confirm-button:disabled, .companion-context #evolution-confirm-button:disabled, .companion-context #pets-rename-save:disabled { opacity:1; background-image:url('Components/button_disabled.png'); color:#314e5c; }
.companion-context #heal-close-button, .companion-context #level-up-close-button, .companion-context #evolution-close-button, .companion-context #pets-rename-close { background-color:#a2c0c6; color:#183747; border-color:#86a9b0; }
