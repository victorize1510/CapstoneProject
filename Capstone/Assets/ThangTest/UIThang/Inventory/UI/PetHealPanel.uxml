<ui:UXML xmlns:ga="Capstone.Game.UISystem" xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
  <ui:Style src="../../../../Game/UISystem/Resources/UI/GreenAngular/GreenAngular.uss" />
  <ui:VisualElement name="heal-modal-overlay" class="ga-overlay">
    <ga:AngularSurface class="ga-popup" role="shell" name="heal-modal-dialog" style="width:650px;height:628px;">
      <ga:AngularSurface class="ga-modal-header" role="primary" shape="tab">
        <ui:Label name="" text="HỒI PHỤC" class="ga-popup-title" />
        <ga:AngularButton name="heal-close-button" text="×" class="ga-button ga-close" role="primary" shape="diamond" />
      </ga:AngularSurface>
      <ga:AngularSurface class="ga-summary heal-summary" role="panel">
        <ga:AngularSurface class="ga-summary-portrait" role="shell" name="heal-pet-portrait">
          <ui:Label name="heal-pet-portrait-fallback" text="◇" class="ga-art-fallback" />
        </ga:AngularSurface>
        <ui:VisualElement class="ga-summary-copy">
          <ui:Label name="heal-pet-name" text="Chọn một thú" class="ga-pet-name" />
          <ui:VisualElement class="ga-summary-meta">
            <ui:VisualElement class="ga-info-row">
              <ui:Label name="" text="Loài" class="ga-info-key" />
              <ui:Label name="heal-pet-species" text="—" class="ga-info-value" />
            </ui:VisualElement>
            <ui:VisualElement class="ga-info-row">
              <ui:Label name="" text="Hệ" class="ga-info-key" />
              <ui:Label name="heal-pet-element" text="—" class="ga-info-value" />
            </ui:VisualElement>
            <ui:VisualElement class="ga-info-row">
              <ui:Label name="" text="Độ hiếm" class="ga-info-key" />
              <ui:Label name="heal-pet-rarity" text="—" class="ga-info-value" />
            </ui:VisualElement>
            <ui:VisualElement class="ga-info-row">
              <ui:Label name="" text="Trạng thái" class="ga-info-key" />
              <ui:Label name="heal-pet-status" text="—" class="ga-info-value" />
            </ui:VisualElement>
          </ui:VisualElement>
        </ui:VisualElement>
      </ga:AngularSurface>
      <ga:AngularSurface class="ga-heal-preview" role="panel">
        <ui:Label name="heal-resource-title" text="HP TRƯỚC / SAU" class="ga-section-title" />
        <ui:VisualElement class="ga-heal-values">
          <ui:Label name="heal-current-health" text="— / —" class="ga-copy" />
          <ui:Label name="heal-health-arrow" text="→" class="ga-copy" />
          <ui:Label name="heal-result-health" text="— / —" class="ga-copy" />
        </ui:VisualElement>
        <ga:AngularSurface class="ga-heal-track" role="track" shape="parallel">
          <ga:AngularSurface class="ga-heal-fill heal-current-fill" role="hp" name="heal-current-fill" shape="parallel" />
          <ga:AngularSurface class="ga-heal-fill heal-recovery-fill" role="hp" name="heal-recovery-fill" shape="parallel" />
        </ga:AngularSurface>
        <ui:Label name="heal-restored-amount" text="" class="ga-heal-amount" />
      </ga:AngularSurface>
      <ui:Label name="" text="VẬT PHẨM HỒI PHỤC" class="ga-heal-item-title ga-section-title" />
      <ga:AngularSurface class="ga-heal-item" role="panel">
        <ga:AngularSurface class="ga-summary-portrait" role="shell" name="heal-item-icon">
          <ui:Label name="heal-item-icon-fallback" text="◇" class="ga-art-fallback" />
        </ga:AngularSurface>
        <ui:VisualElement class="ga-item-copy">
          <ui:Label name="heal-item-name" text="—" class="ga-item-name" />
          <ui:Label name="heal-item-effect" text="—" class="ga-copy" />
        </ui:VisualElement>
        <ui:Label name="heal-item-count" text="— / —" class="ga-item-count" />
      </ga:AngularSurface>
      <ui:Label name="heal-feedback" text="" class="ga-heal-feedback" />
      <ga:AngularButton name="heal-cancel-button" text="Hủy" class="ga-button ga-heal-cancel" role="shell" shape="parallel" />
      <ga:AngularButton name="heal-confirm-button" text="Hồi phục" class="ga-button ga-heal-confirm" role="primary" shape="parallel" />
    </ga:AngularSurface>
  </ui:VisualElement>
</ui:UXML>