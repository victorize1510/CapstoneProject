<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- Load theme, shared controls, panel styles, then the shared header. -->
    <ui:Style src="MenuTheme.uss" />
    <ui:Style src="MenuCommon.uss" />
    <ui:Style src="InventoryPanel.uss" />
    <ui:Style src="InventoryQuantityPopup.uss" />
    <ui:Style src="MenuScreenHeader.uss" />
    <ui:VisualElement name="inventory-panel" class="inventory-panel menu-panel menu-theme">
        <ui:VisualElement name="inventory-shell" class="inventory-shell">
            <ui:VisualElement class="inventory-header screen-header">
                <ui:VisualElement class="inventory-heading screen-heading">
                    <ui:VisualElement class="screen-heading-mark" picking-mode="Ignore" focusable="false" />
                    <ui:Label text="TÚI ĐỒ" class="screen-title" />
                </ui:VisualElement>
                <ui:VisualElement class="inventory-header-actions">
                    <ui:VisualElement class="inventory-currency" tooltip="Vàng đang sở hữu">
                        <ui:Label text="G" class="inventory-currency-icon" />
                        <ui:Label name="inventory-gold-label" text="0" class="inventory-gold-value" />
                    </ui:VisualElement>
                    <ui:Button name="cancel-button" text="←  TRỞ LẠI" class="screen-back" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="inventory-body" class="inventory-body">
                <ui:VisualElement name="category-panel" class="category-panel">
                    <ui:Label text="DANH MỤC" class="category-heading" />
                    <ui:Button name="category-all" class="category-button is-selected">
                        <ui:Label text="▦" class="category-icon" picking-mode="Ignore" />
                        <ui:Label text="Tất cả" class="category-label" picking-mode="Ignore" />
                        <ui:Label text="0" class="category-count" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="category-capture-ball" class="category-button">
                        <ui:Label text="◉" class="category-icon" picking-mode="Ignore" />
                        <ui:Label text="Dụng cụ bắt" class="category-label" picking-mode="Ignore" />
                        <ui:Label text="0" class="category-count" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="category-medicine" class="category-button">
                        <ui:Label text="+" class="category-icon" picking-mode="Ignore" />
                        <ui:Label text="Hồi phục" class="category-label" picking-mode="Ignore" />
                        <ui:Label text="0" class="category-count" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="category-food" class="category-button">
                        <ui:Label text="♧" class="category-icon" picking-mode="Ignore" />
                        <ui:Label text="Thức ăn" class="category-label" picking-mode="Ignore" />
                        <ui:Label text="0" class="category-count" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="category-material" class="category-button">
                        <ui:Label text="◇" class="category-icon" picking-mode="Ignore" />
                        <ui:Label text="Nguyên liệu" class="category-label" picking-mode="Ignore" />
                        <ui:Label text="0" class="category-count" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="category-equipment" class="category-button">
                        <ui:Label text="⚔" class="category-icon" picking-mode="Ignore" />
                        <ui:Label text="Trang bị" class="category-label" picking-mode="Ignore" />
                        <ui:Label text="0" class="category-count" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="category-quest-item" class="category-button">
                        <ui:Label text="!" class="category-icon" picking-mode="Ignore" />
                        <ui:Label text="Vật phẩm nhiệm vụ" class="category-label" picking-mode="Ignore" />
                        <ui:Label text="0" class="category-count" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="category-key-item" class="category-button">
                        <ui:Label text="◆" class="category-icon" picking-mode="Ignore" />
                        <ui:Label text="Vật phẩm chính" class="category-label" picking-mode="Ignore" />
                        <ui:Label text="0" class="category-count" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement class="inventory-grid-column">
                    <ui:VisualElement class="inventory-tools">
                        <ui:TextField name="inventory-search-field" class="inventory-search" tooltip="Tìm tên, mã hoặc danh mục vật phẩm" />
                        <ui:Button name="inventory-search-field-clear" text="×" tooltip="Xóa tìm kiếm" class="menu-search-clear" />
                        <ui:DropdownField name="inventory-sort-field" class="inventory-sort" />
                        <ui:DropdownField name="inventory-filter-field" class="inventory-filter" />
                        <ui:Button name="inventory-view-button" text="☷" class="inventory-view-button" tooltip="Chuyển sang danh sách" />
                    </ui:VisualElement>
                    <ui:VisualElement class="inventory-grid-frame">
                        <ui:ScrollView name="item-scroll" class="inventory-grid-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                            <ui:VisualElement name="item-grid" class="item-grid" />
                        </ui:ScrollView>
                        <ui:Label name="no-items-label" text="Danh mục này chưa có vật phẩm." class="no-items-label" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="inventory-detail-column">
                    <ui:Label name="inventory-detail-empty" text="Chọn vật phẩm để xem thông tin." class="inventory-detail-empty" picking-mode="Ignore" />
                    <ui:ScrollView name="detail-panel" class="detail-panel inventory-initially-hidden" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                        <ui:VisualElement name="detail-icon" class="detail-icon">
                            <ui:Label name="detail-icon-placeholder" text="◇" class="detail-icon-placeholder" />
                        </ui:VisualElement>
                        <ui:Label name="detail-name" text="Chọn một vật phẩm" class="detail-name" />
                        <ui:VisualElement class="detail-badges">
                            <ui:Label name="detail-rarity" text="" class="detail-rarity" />
                            <ui:Label name="detail-category" text="" class="detail-category" />
                        </ui:VisualElement>
                        <ui:Label name="detail-quantity" text="" class="detail-owned" />
                        <ui:VisualElement class="detail-divider" />
                        <ui:Label name="detail-description" text="Chọn vật phẩm trong túi để xem thông tin." class="detail-description" />
                        <ui:Label name="detail-effect" text="" class="detail-effect" />
                        <ui:VisualElement name="detail-source-block" class="detail-source-block">
                            <ui:Label text="NGUỒN THU THẬP" class="detail-section-title" />
                            <ui:Label name="detail-source" text="" class="detail-source" />
                        </ui:VisualElement>
                        <ui:Label name="detail-flavor" text="" class="detail-flavor" />
                    </ui:ScrollView>
                    <ui:VisualElement name="inventory-actions" class="inventory-actions inventory-initially-hidden">
                        <ui:Button name="use-button" text="SỬ DỤNG" class="inventory-action-button inventory-primary-action" />
                        <ui:VisualElement class="inventory-secondary-actions">
                            <ui:Button name="equip-button" text="GÁN PHÍM TẮT" class="inventory-action-button" />
                            <ui:Button name="drop-button" text="BỎ" class="inventory-action-button inventory-drop-action" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="inventory-footer">
                <ui:Label text="Q / E: danh mục  •  ↑ / ↓: chọn vật phẩm  •  Esc: quay lại" class="inventory-input-hint" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
