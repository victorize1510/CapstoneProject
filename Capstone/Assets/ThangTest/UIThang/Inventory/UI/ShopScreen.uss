/* SHOP A only. Existing three-column flex tree, five-column template and callbacks stay intact. */
.shop-panel.shop-a { position:absolute;left:0;top:0;right:auto;bottom:auto;width:1600px;height:900px;transform-origin:top left;display:none;margin:0;padding:0;min-width:0;min-height:0;color:#202B45;font-size:18px;opacity:1; }
.shop-panel.shop-a .screen-header { position:relative;height:104px;min-height:104px;max-height:104px;flex-shrink:0;padding:0;margin:0;border-width:0;background-color:rgba(0,0,0,0); }
.shop-a .shop-subtitle { display:none; }
.shop-a .screen-header .inventory-currency { position:absolute;left:1176px;top:34px;width:200px;height:46px;margin:0;padding:0 12px;flex-direction:row;align-items:center;justify-content:space-between;background-color:#3C4772;border-width:1px;border-color:#8996B0;border-radius:0; }
.shop-a .inventory-currency-icon { color:#CCAD83;font-size:22px;-unity-font-style:bold; }
.shop-a .inventory-gold-value { color:#EDE9E1;font-size:22px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
.shop-a .shop-body { flex-grow:1;min-height:0;flex-direction:row;padding:8px 24px 48px; }
.shop-a .shop-column { position:relative;min-width:0;min-height:0;padding:12px;border-width:0;border-radius:0;background-color:rgba(0,0,0,0); }
.shop-a .shop-sidebar { width:19%;flex-shrink:0;margin-right:12px; }
.shop-a .shop-products { flex-grow:1;flex-basis:0;margin-right:12px; }
.shop-a .shop-details { width:28%;flex-shrink:0; }
.shop-a .shop-a-layer { position:absolute;left:0;top:0;right:0;bottom:0;margin:0;padding:0; }
.shop-a Label { padding:0;margin:0;opacity:1; }
.shop-a .shop-a-button { position:relative;margin:0;padding:0;border-width:0;border-radius:0;background-color:rgba(0,0,0,0);color:#202B45;opacity:1;min-width:0;min-height:0; }
.shop-panel.shop-a .shop-a-button:hover,.shop-panel.shop-a .shop-a-button:active,.shop-panel.shop-a .shop-a-button:focus,.shop-panel.shop-a .shop-a-button:disabled { border-width:0;background-color:rgba(0,0,0,0);opacity:1; }
.shop-panel.shop-a .unity-disabled { opacity:1; }
.shop-a .shop-a-caption { position:absolute;left:8px;right:8px;top:0;bottom:0;-unity-text-align:middle-center;font-size:18px;-unity-font-style:bold;color:#202B45;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
.shop-a .shop-category { height:70px;min-height:70px;flex-shrink:0;flex-direction:row;align-items:center;padding:10px 14px;margin-bottom:12px; }
.shop-a .shop-category-icon { width:26px;height:26px;min-width:26px;margin-right:10px; }
.shop-a .shop-category-name { flex-grow:1;flex-shrink:1;min-width:0;white-space:normal;font-size:17px;color:#202B45; }
.shop-a .shop-category-count { width:28px;flex-shrink:0;font-size:16px;-unity-text-align:middle-right;color:#202B45; }
.shop-a .shop-category.is-selected .shop-category-name,.shop-a .shop-category.is-selected .shop-category-count { color:#EDE9E1; }
.shop-a .shop-category.is-selected .shop-category-icon { -unity-background-image-tint-color:#EDE9E1; }
.shop-a .shop-toolbar { flex-direction:row;align-items:center;flex-shrink:0;height:44px;margin-bottom:12px; }
.shop-a .shop-search-group { position:relative;flex-grow:1;flex-shrink:1;min-width:80px;height:44px;margin-right:12px; }
.shop-panel.shop-a .shop-search { width:auto;flex-grow:1;height:44px;margin:0;padding:0;border-width:0;background-color:rgba(0,0,0,0); }
.shop-a #shop-search-glyph { position:absolute;left:12px;top:12px;width:20px;height:20px; }
.shop-panel.shop-a #shop-clear { position:absolute;right:6px;top:4px;width:34px;height:36px; }
.shop-a #shop-clear .shop-a-caption { font-size:26px;-unity-font-style:normal;left:0;right:0; }
.shop-a .shop-sort { width:172px;min-width:172px;flex-shrink:0;height:44px;margin:0;padding:0; }
.shop-panel.shop-a .unity-base-field__input,.shop-panel.shop-a .unity-base-field__input:focus,.shop-panel.shop-a .unity-base-popup-field__input { position:relative;background-color:rgba(0,0,0,0);color:#202B45;border-width:0;border-radius:0;padding:0 14px;margin:0;font-size:18px; }
.shop-panel.shop-a #shop-search .unity-base-field__input { padding-left:40px;padding-right:44px; }
.shop-panel.shop-a .unity-base-text-field__placeholder { color:#39455E;opacity:1; }
.shop-a .unity-base-popup-field__text { color:#202B45;font-size:17px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0; }
.shop-a .shop-grid-scroll { flex-grow:1;min-height:0; }
.shop-a .shop-grid { flex-direction:row;flex-wrap:wrap; }
.shop-a .shop-grid > TemplateContainer { width:20%;min-width:0;flex-shrink:0; }
.shop-panel.shop-a .shop-card { height:214px;margin:4px;padding:10px 8px;flex-direction:column; }
.shop-a .shop-card-icon { height:106px;min-height:106px;max-width:106.6667px;align-self:center;width:100%;background-size:contain;justify-content:center;align-items:center; }
.shop-a .shop-card-placeholder { font-size:32px;color:#39455E; }
.shop-a .shop-card-name { height:44px;min-height:44px;max-height:44px;white-space:normal;overflow:hidden;text-overflow:ellipsis;font-size:15px;-unity-text-align:middle-center;color:#202B45; }
.shop-a .shop-card-status { min-height:18px;white-space:normal;font-size:12px;-unity-text-align:middle-center;color:#59475D; }
.shop-a .shop-card-price { margin-top:auto;height:24px;min-height:24px;padding:3px 2px;border-top-width:1px;border-top-color:#8996B0;background-color:rgba(82,96,122,.12);font-size:13px;color:#202B45;-unity-text-align:middle-center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
.shop-a .shop-detail-scroll { flex-grow:1;flex-basis:0;min-height:0; }
.shop-a .shop-detail-scroll .unity-scroll-view__content-container { padding-right:2px; }
.shop-a .shop-portrait-frame { position:relative;height:200px;min-height:200px;flex-shrink:0;justify-content:center;align-items:center;margin-bottom:12px; }
.shop-a .shop-portrait { width:106.6667px;height:106.6667px;flex-shrink:0;background-color:rgba(0,0,0,0); }
.shop-a .shop-item-name { font-size:26px;-unity-font-style:bold;white-space:normal;color:#202B45; }
.shop-a .shop-owned { font-size:17px;margin-top:6px;margin-bottom:10px;white-space:normal;color:#39455E; }
.shop-a .shop-badges { flex-direction:row;flex-wrap:wrap;margin-bottom:14px; }
.shop-a .shop-badge { padding:3px 8px;margin-right:6px;margin-bottom:4px;background-color:rgba(82,96,122,.14);border-bottom-width:1px;border-bottom-color:#8996B0;font-size:14px;white-space:normal;color:#202B45; }
.shop-a .ui-copy-section { padding:0;margin-bottom:14px;background-color:rgba(0,0,0,0);border-width:0; }
.shop-a .ui-section-heading,.shop-a .shop-section-title { min-height:24px;font-size:18px;-unity-font-style:bold;margin-bottom:6px;color:#202B45; }
.shop-a .shop-description { white-space:normal;font-size:18px;color:#202B45;margin-bottom:8px; }
.shop-a .shop-purchase { flex-shrink:0;padding-top:12px;margin-top:8px;border-top-width:1px;border-top-color:#8996B0; }
.shop-a .shop-quantity-row { flex-direction:row;align-items:stretch;height:42px;min-height:42px; }
.shop-panel.shop-a .shop-quantity-row .shop-a-button { width:42px;flex-shrink:0;margin:0; }
.shop-a #shop-quantity { position:relative;flex-grow:1;min-width:0;margin:0 4px;padding:0; }
.shop-a #shop-quantity .unity-base-field__input { -unity-text-align:middle-center; }
.shop-panel.shop-a .shop-quantity-row #shop-max { width:72px;margin-left:8px; }
.shop-a #shop-max .shop-a-caption { font-size:16px; }
.shop-a .shop-total-row { flex-direction:row;align-items:center;justify-content:space-between;margin-top:12px;min-height:30px; }
.shop-a .shop-total-row Label { font-size:18px;color:#202B45; }
.shop-a .shop-total-row #shop-total { font-size:23px;-unity-font-style:bold; }
.shop-a .shop-reason { min-height:22px;white-space:normal;font-size:15px;color:#59475D;margin-top:6px; }
.shop-panel.shop-a .shop-buy { width:auto;height:48px;min-height:48px;margin-top:8px; }
.shop-a .shop-buy .shop-a-caption { font-size:22px;color:#EDE9E1; }
.shop-a .shop-buy:disabled .shop-a-caption { color:#26334B; }
.shop-a .shop-feedback { min-height:28px;max-height:56px;flex-shrink:0;white-space:normal;overflow:hidden;text-overflow:ellipsis;font-size:16px;margin-top:8px;color:#294D46; }
.shop-a .shop-feedback.is-error { color:#71334D; }
.shop-a .menu-detail-empty { white-space:normal;flex-grow:1;-unity-text-align:middle-center;color:#39455E;font-size:20px; }
.shop-a .shop-sort-overlay { position:absolute;left:0;right:0;top:0;bottom:0;background-color:rgba(0,0,0,0); }
.shop-a .shop-sort-popup { position:absolute;padding:8px; }
.shop-panel.shop-a .shop-sort-choice { height:44px;min-height:44px;flex-shrink:0;margin-bottom:4px; }
.shop-a .shop-sort-choice .shop-a-caption { -unity-text-align:middle-left;font-size:17px;padding-left:12px; }
.shop-a .shop-sort-choice.is-selected .shop-a-caption { color:#EDE9E1; }
.shop-a .shop-category-icon { -unity-background-image-tint-color:#202B45; }
.shop-a .shop-action-glyph { position:absolute;left:50%;top:50%;width:20px;height:20px;margin-left:-10px;margin-top:-10px; }
