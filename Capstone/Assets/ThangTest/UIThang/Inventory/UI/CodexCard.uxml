<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Button class="codex-card">
        <ui:VisualElement name="portrait" class="codex-card-portrait" picking-mode="Ignore">
            <ui:Label name="unknown" text="?" class="codex-card-unknown" picking-mode="Ignore" />
            <ui:Label name="favorite" text="★" class="codex-card-favorite" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="codex-card-footer" picking-mode="Ignore">
            <ui:Label name="number" picking-mode="Ignore" />
            <ui:Label name="type" class="codex-card-type" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:Button>
</ui:UXML>
