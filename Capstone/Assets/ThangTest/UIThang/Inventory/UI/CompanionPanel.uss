.companion-design .companion-bar-track {height:14px;flex-grow:1;margin-right:12px;overflow:visible;background-color:transparent;background-image:none;border-width:0;}
.companion-design .companion-bar-fill {height:100%;width:0;background-color:transparent;border-radius:0;}
.companion-design .companion-content {background-image:none;background-color:transparent;border-width:0;}
.companion-design .companion-stat-row .companion-icon {width:21px;height:21px;margin-right:9px;}
