.companion-design .companion-icon.ci-hp {-unity-background-image-tint-color:#C47D8B;}
.companion-design .companion-icon.ci-upgrade {-unity-background-image-tint-color:#76A6C3;}
.companion-design .companion-emblem {-unity-background-image-tint-color:white;}
.companion-design .companion-embedded-skills .skills-helper-label {display:none;}
.pets-panel.companion-panel .pet-card-level {left:auto;right:8px;bottom:0;top:auto;width:62px;height:20px;-unity-text-align:middle-right;}
.companion-design .companion-embedded-skills .skills-equipped-name {-unity-font-style:bold;}
.companion-design .companion-embedded-skills .skills-learned-name {-unity-font-style:bold;}
.pets-panel.companion-panel .pet-card-hp-value {display:none;}
.pets-panel.companion-panel .pet-card-level {color:#202B45;font-size:12px;}
.companion-design .companion-mode .companion-button {margin-right:8px;}

/* Interaction R3: fixed rail, stable typography, full-bleed dock. */
.companion-design .companion-tabs {left:720px;top:108px;width:832px;height:48px;}
.companion-design .companion-tab {width:272px;min-width:272px;height:48px;min-height:48px;top:0;margin-right:8px;padding:0;border-width:0;}
.companion-design .companion-tab Label,.companion-design .companion-tab:hover Label,.companion-design .companion-tab:focus Label,.companion-design .companion-tab:active Label {font-size:21px;-unity-font-style:bold;padding:0;margin:0;}
.companion-design .companion-stat-name {font-size:16px;}
.companion-design .companion-meta Label {font-size:16px;}
.companion-design .companion-growth-copy {font-size:18px;white-space:normal;}
.companion-design .companion-growth-reason {font-size:16px;white-space:normal;}
.companion-design .companion-growth-title {font-size:24px;-unity-font-style:bold;}
.companion-design .companion-name {font-size:32px;-unity-font-style:bold;}
.companion-design .companion-embedded-skills .skills-equipped-name {font-size:18px;white-space:normal;height:46px;top:12px;}
.companion-design .companion-embedded-skills .skills-equipped-meta {font-size:16px;bottom:8px;}
.companion-design .companion-embedded-skills .skills-learned-name {font-size:18px;white-space:normal;max-height:44px;}
.companion-design .companion-embedded-skills .skills-learned-element,.companion-design .companion-embedded-skills .skills-learned-meta {font-size:16px;}
.companion-design .companion-inline-detail .skills-tooltip-name {font-size:21px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.companion-design .companion-inline-detail .skills-tooltip-description {font-size:16px;max-height:42px;overflow:hidden;text-overflow:ellipsis;}
.companion-design .companion-inline-detail .skills-tooltip-row {min-height:24px;}
.companion-design .companion-inline-detail .skills-tooltip-key {font-size:16px;}
.companion-design .r3-equip-preview {position:absolute;left:16px;right:16px;bottom:58px;height:24px;font-size:16px;-unity-font-style:bold;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.companion-design #r3-equip-confirm {position:absolute;left:16px;right:16px;bottom:12px;height:44px;font-size:20px;color:#EDE9E1;-unity-font-style:bold;}
.companion-design #r3-equip-confirm:disabled {color:#202B45;}
.pets-panel.companion-panel .pet-card-content {position:absolute;left:0;right:0;top:0;bottom:0;padding:0;margin:0;}
.pets-panel.companion-panel .pet-card-portrait {position:absolute;left:0;top:0;width:210px;height:112px;flex-grow:0;flex-shrink:0;}
.pets-panel.companion-panel .pet-card-info {position:absolute;left:4px;right:4px;top:auto;bottom:4px;height:26px;padding:0;background-color:transparent;}
.pets-panel.companion-panel .pet-card-name-row {display:none;}
.pets-panel.companion-panel .pet-card-bar-row {position:absolute;left:5px;right:67px;top:5px;height:18px;background-color:rgba(32,43,69,.84);padding:0 3px;}
.pets-panel.companion-panel .pet-card-bar-label {font-size:14px;color:#EDE9E1;-unity-font-style:bold;width:23px;}
.pets-panel.companion-panel .pet-card-level {position:absolute;right:3px;bottom:3px;top:auto;width:60px;height:18px;font-size:14px;-unity-font-style:bold;color:#EDE9E1;background-color:rgba(32,43,69,.84);padding-right:3px;}
.pets-panel.companion-panel .pet-card-bar-track {height:6px;}
.pets-panel.companion-panel .pet-card-top {left:10px;right:10px;top:9px;}
.companion-design .r3-swap-actions {position:absolute;left:1360px;top:20px;width:178px;height:100px;}
.companion-design .r3-swap-actions .companion-button {height:44px;min-height:44px;width:178px;margin-bottom:8px;font-size:20px;-unity-font-style:bold;color:#EDE9E1;}
.companion-design .r3-swap-marker {position:absolute;left:72px;right:38px;top:8px;height:24px;font-size:15px;padding-left:23px;-unity-font-style:bold;background-color:rgba(32,43,69,.90);-unity-text-align:middle-left;}
.companion-design #r3-swap-arrow {position:absolute;left:3px;top:4px;width:16px;height:16px;-unity-background-scale-mode:scale-to-fit;}
.companion-design .companion-inline-detail .skills-tooltip-row {min-height:20px;height:20px;}
.companion-design .companion-inline-detail .skills-tooltip-name {height:30px;}
.companion-design .companion-inline-detail .skills-tooltip-description {height:36px;max-height:36px;}
.companion-design .companion-stat-name,.companion-design .companion-stat-value,.companion-design .companion-resource-name,.companion-design .companion-resource-value {font-size:18px;}
.companion-design .companion-small-button Label {font-size:20px;}
.companion-design .companion-inline-detail #r3-equip-confirm .angular-button-caption {font-size:20px;-unity-font-style:bold;color:#EDE9E1;}
.companion-design .companion-inline-detail #r3-equip-confirm:disabled .angular-button-caption {color:#202B45;}
.companion-design .companion-stat-value,.companion-design .companion-resource-value {overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.companion-design #r3-skill-description-scroll {height:36px;max-height:36px;min-height:36px;margin:0;padding:0;}
.companion-design #r3-skill-description-scroll .skills-tooltip-description {height:auto;max-height:none;overflow:visible;white-space:normal;}
.companion-design #r3-skill-description-scroll .unity-scroll-view__vertical-scroller {width:6px;}
