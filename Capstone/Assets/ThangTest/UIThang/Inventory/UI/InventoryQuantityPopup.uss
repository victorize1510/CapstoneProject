/* Bag quantity dialog, attached to the composed root because the popup is created there. */

.quantity-popup-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(11, 18, 18, 0.58);
}

.quantity-popup-panel {
    width: 420px;
    min-height: 450px;
    align-items: center;
    background-color: #efe2c4;
    border-width: 2px;
    border-color: #a88e58;
    border-radius: 8px;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 22px;
    padding-bottom: 22px;
}

.quantity-popup-title {
    color: #2f2a20;
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.quantity-popup-icon {
    width: 92px;
    height: 92px;
    background-color: #7d8b5e;
    border-width: 2px;
    border-color: #cbb783;
    border-radius: 7px;
    margin-bottom: 12px;
}

.quantity-popup-item-name {
    width: 100%;
    color: #2f2a20;
    font-size: 21px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 6px;
}

.quantity-popup-owned {
    color: #746742;
    font-size: 15px;
    -unity-text-align: middle-center;
    margin-bottom: 18px;
}

.quantity-stepper {
    width: 100%;
    height: 46px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
}

.quantity-step-button {
    width: 46px;
    height: 42px;
    color: #f8edcd;
    background-color: #53734f;
    border-width: 1px;
    border-color: #8fa96c;
    font-size: 21px;
    -unity-font-style: bold;
}

.quantity-field {
    flex-grow: 1;
    height: 42px;
    margin-left: 10px;
    margin-right: 10px;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.quantity-slider {
    width: 100%;
    margin-bottom: 12px;
}

.quantity-quick-row {
    width: 100%;
    height: 38px;
    flex-direction: row;
    margin-bottom: 24px;
}

.quantity-quick-button {
    flex-grow: 1;
    height: 34px;
    margin-left: 4px;
    margin-right: 4px;
    color: #4a412f;
    background-color: #e1d4b6;
    border-width: 1px;
    border-color: #ad9561;
    font-size: 14px;
    -unity-font-style: bold;
}

.quantity-action-row {
    width: 100%;
    height: 44px;
    flex-direction: row;
    justify-content: center;
}

.quantity-confirm-button,
.quantity-cancel-button {
    width: 140px;
    height: 42px;
    margin-left: 8px;
    margin-right: 8px;
    color: #f8edcd;
    border-width: 1px;
    font-size: 16px;
    -unity-font-style: bold;
}

.quantity-confirm-button {
    background-color: #267154;
    border-color: #78b884;
}

.quantity-cancel-button {
    background-color: #4a4d47;
    border-color: #9d9a84;
}
