/* Owning panel rules. Shared colors come from MenuTheme.uss. */

.box-card-top {
    flex-direction: row;
    align-items: center;
}

.box-selected-top {
    flex-direction: row;
}

.box-large-bar-row,
.box-stats-row,
.box-actions-row {
    flex-direction: row;
    align-items: center;
}

.box-title-group {
    min-width: 420px;
}

.box-source-label {
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 6px;
    padding-bottom: 6px;
    font-size: 12px;
    color: #49624b;
    background-color: #e5ebdc;
    border-radius: 4px;
}

.box-party-section {
    border-bottom-width: 1px;
    border-bottom-color: #d0d5c5;
}

.box-section-hint {
    font-size: 12px;
    color: #697869;
}

.box-party-card {
    width: 16.1%;
    flex-direction: column;
    align-items: stretch;
}

.box-party-card.is-target {
    border-bottom-width: 4px;
    border-bottom-color: #2b79b7;
}

.box-party-card.is-empty {
    opacity: 0.62;
}

.box-card-top {
    height: 20px;
}

.box-slot-number {
    width: 22px;
}

.box-favorite-badge {
    flex-grow: 1;
    margin-right: 2px;
    -unity-font-style: bold;
}

.box-party-portrait {
    margin-top: 2px;
}

.box-card-name {
    font-size: 13px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
}

.box-card-meta {
    font-size: 10px;
    color: #5c6d5e;
    white-space: nowrap;
    overflow: hidden;
}

.box-card-rarity {
    font-size: 9px;
    color: #3c7b42;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
}

.box-small-bar-row {
    height: 12px;
    flex-direction: row;
    align-items: center;
}

.box-small-bar-label {
    width: 28px;
    font-size: 8px;
    color: #506251;
}

.box-small-bar-track {
    flex-grow: 1;
    height: 5px;
    overflow: hidden;
    background-color: #d8ddd1;
    border-radius: 3px;
}

.box-small-bar-fill {
    height: 100%;
}

.box-hp-fill {
    background-color: #64a835;
}

.box-selected-panel {
    min-height: 0;
    border-width: 1px;
    border-color: #c5ceba;
    border-radius: 6px;
}

.box-storage-panel {
    min-width: 0;
    border-width: 1px;
    border-color: #c5ceba;
    border-radius: 6px;
}

.box-selected-panel {
    margin-right: 12px;
}

.box-selected-top {
    min-height: 150px;
    align-items: stretch;
}

.box-selected-portrait {
    min-width: 145px;
    margin-right: 14px;
}

.box-selected-summary {
    flex-grow: 1;
    min-width: 0;
    justify-content: center;
}

.box-selected-meta {
    margin-top: 5px;
    margin-bottom: 12px;
    font-size: 12px;
    color: #5b695c;
    white-space: normal;
}

.box-large-bar-row {
    height: 28px;
}

.box-large-bar-label {
    width: 32px;
    font-size: 10px;
    -unity-font-style: bold;
}

.box-large-bar-track {
    flex-grow: 1;
    height: 9px;
    overflow: hidden;
    background-color: #dce1d6;
    border-radius: 5px;
}

.box-large-bar-fill {
    height: 100%;
}

.box-large-bar-value {
    width: 92px;
    margin-left: 8px;
    font-size: 10px;
    -unity-text-align: middle-right;
}

.box-subsection-title {
    margin-top: 11px;
    margin-bottom: 6px;
    font-size: 13px;
    color: #2f6935;
    -unity-font-style: bold;
}

.box-stats-row {
    height: 62px;
}

.box-stat-cell {
    flex-grow: 1;
    height: 55px;
    margin-right: 5px;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    background-color: var(--menu-surface, #ffffff);
}

.box-stat-name {
    font-size: 10px;
    color: #647064;
}

.box-stat-value {
    margin-top: 4px;
    font-size: 15px;
    -unity-font-style: bold;
    color: #293d2b;
}

.box-selected-skills {
    height: 70px;
    flex-direction: row;
}

.box-skill-chip {
    flex-grow: 1;
    min-width: 0;
    margin-right: 5px;
    padding: 6px;
    align-items: center;
    justify-content: center;
    background-color: #edf3e8;
    border-radius: 4px;
}

.box-skill-icon {
    width: 28px;
    height: 28px;
    margin-bottom: 3px;
    -unity-background-scale-mode: scale-to-fit;
}

.box-skill-name {
    font-size: 9px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
}

.box-skill-meta {
    margin-top: 2px;
    font-size: 8px;
    color: #647064;
    white-space: nowrap;
    overflow: hidden;
}

.box-actions-row {
    margin-top: 8px;
    min-height: 42px;
}

.box-action-button {
    flex-grow: 1;
    min-width: 0;
}

.box-feedback {
    min-height: 28px;
    margin-top: 6px;
    padding-top: 5px;
    padding-right: 8px;
    padding-bottom: 5px;
    padding-left: 8px;
    white-space: normal;
    background-color: #f4f1e5;
}

.box-search-field {
    width: 26%;
}

.box-sort-field {
    margin-left: 8px;
}

.box-filter-toggle {
    min-width: 78px;
    margin-left: 8px;
}

.box-filter-panel {
    margin-top: 5px;
}

.box-filter-chip {
    border-color: #a9b8a2;
}

.box-storage-card {
    align-items: stretch;
}

.box-storage-favorite {
    -unity-font-style: bold;
}

.box-storage-portrait {
    height: 74px;
}

.box-storage-meta {
    white-space: nowrap;
    overflow: hidden;
}

.box-purchase-card {
    color: #2b422f;
}

.box-purchase-after {
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: #ced5c5;
}

.box-purchase-actions {
    justify-content: flex-end;
}

.box-popup-button {
    min-width: 115px;
    margin-left: 8px;
}

.box-panel {
    display: flex;
    position: absolute;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    color: #173b45;
    border-color: #8db9ae;
    overflow: hidden;
}

.box-header {
    height: 76px;
    min-height: 76px;
    padding-left: 24px;
    padding-right: 22px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: #c9ded7;
    background-color: var(--menu-background, #f8f4eb);
}

.box-title-group,
.box-page-navigation,
.box-sort-group,
.box-capacity-group,
.box-storage-identity,
.box-selected-title-row,
.box-selected-meta-row {
    flex-direction: row;
    align-items: center;
}

.box-selected-body {
    flex-direction: row;
}

.box-health-row,
.box-secondary-actions,
.box-purchase-actions {
    flex-direction: row;
    align-items: center;
}

.box-title-mark {
    width: 30px;
    height: 30px;
    margin-right: 15px;
    rotate: 45deg;
    background-color: #2fa8a7;
    border-width: 3px;
    border-color: #d8f3dc;
}

.box-title {
    color: #123f73;
    font-size: 28px;
    -unity-font-style: bold;
}

.box-subtitle {
    margin-top: 2px;
    color: #4d6871;
    font-size: 13px;
}

.box-source-label,
.box-section-hint {
    display: none;
}

.box-back-button {
    min-width: 146px;
    height: 42px;
    color: #173f68;
    background-color: #fbfefd;
    border-width: 1px;
    border-color: #8fb9b0;
    border-radius: 9px;
    font-size: 13px;
    -unity-font-style: bold;
}

.box-back-button:hover,
.box-page-button:hover,
.box-filter-toggle:hover,
.box-action-button:hover {
    background-color: #e8f6f1;
}

.box-main-content {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    padding-top: 10px;
    padding-right: 14px;
    padding-bottom: 8px;
    padding-left: 14px;
    flex-direction: row;
}

.box-workspace {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
}

.box-surface {
    min-width: 0;
    min-height: 0;
    border-width: 1px;
    border-color: #b8d3cc;
    border-radius: 12px;
    background-color: var(--menu-surface, #ffffff);
}

.box-party-section {
    height: 202px;
    min-height: 202px;
    flex-shrink: 0;
    padding-top: 12px;
    padding-right: 14px;
    padding-bottom: 14px;
    padding-left: 14px;
    background-color: var(--menu-surface, #ffffff);
}

.box-section-heading {
    height: 50px;
    min-height: 50px;
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
}

.box-section-title {
    color: #15566d;
    font-size: 18px;
    -unity-font-style: bold;
}

.box-section-subtitle {
    margin-top: 2px;
    color: #53727a;
    font-size: 12px;
}

.box-party-row {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
    align-items: stretch;
}

.box-party-card {
    position: relative;
    height: 126px;
    min-height: 126px;
    min-width: 0;
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 8px;
    padding: 4px;
    overflow: hidden;
    color: #183d47;
    border-width: 1px;
    border-color: #abcac4;
    border-radius: 9px;
    background-color: var(--menu-surface, #ffffff);
}

.box-party-card:hover,
.box-storage-card:hover {
    background-color: #e3f5ef;
    border-color: #49aaa0;
}

.box-party-card.is-selected,
.box-storage-card.is-selected {
    background-color: #ebf9df;
    border-width: 3px;
    border-color: #58b942;
}

.box-party-card.is-swap-source,
.box-storage-card.is-swap-source {
    background-color: #fff4c9;
    border-width: 3px;
    border-color: #d5a72a;
}

.box-party-card.is-empty {
    background-color: #edf5f3;
}

.box-party-portrait {
    position: relative;
    width: 100%;
    height: auto;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    align-items: center;
    justify-content: center;
    -unity-background-scale-mode: scale-to-fit;
}

.box-party-card.is-empty .box-party-portrait,
.box-party-card.is-empty .box-lead-badge {
    display: none;
}

.box-portrait-fallback {
    width: 100%;
    height: 100%;
    color: #87a9a3;
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.box-slot-number {
    position: absolute;
    left: 5px;
    top: 5px;
    min-width: 24px;
    height: 24px;
    padding-left: 4px;
    padding-right: 4px;
    color: #244c57;
    background-color: rgba(252, 255, 253, 0.94);
    border-radius: 6px;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.box-lead-badge {
    position: absolute;
    left: 34px;
    top: 6px;
    height: 21px;
    padding-left: 3px;
    padding-right: 3px;
    color: white;
    background-color: #43a64a;
    border-radius: 5px;
    font-size: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.box-favorite-badge,
.box-storage-favorite {
    position: absolute;
    right: 6px;
    top: 4px;
    width: 24px;
    height: 24px;
    color: #e5ad25;
    background-color: rgba(255, 255, 250, 0.9);
    border-radius: 12px;
    font-size: 18px;
    -unity-text-align: middle-center;
}

.box-party-level {
    position: absolute;
    right: 6px;
    bottom: 5px;
    height: 21px;
    padding-left: 7px;
    padding-right: 7px;
    color: white;
    background-color: rgba(22, 61, 70, 0.86);
    border-radius: 5px;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.box-party-card .box-favorite-badge {
    width: 18px;
    height: 18px;
    right: 4px;
    font-size: 14px;
}

.box-storage-panel {
    position: relative;
    flex-grow: 1;
    min-height: 0;
    margin-top: 10px;
    padding: 10px;
    background-color: var(--menu-surface, #ffffff);
}

.box-storage-toolbar {
    height: auto;
    min-height: 58px;
    flex-shrink: 0;
    flex-wrap: wrap;
    flex-direction: row;
    align-items: center;
}

.box-storage-identity {
    width: 184px;
    min-width: 184px;
    flex-shrink: 0;
    margin-right: 10px;
}

.box-storage-heading {
    flex-grow: 1;
    min-width: 0;
}

.box-storage-mark {
    width: 38px;
    height: 38px;
    margin-right: 8px;
    color: #2e9cad;
    font-size: 33px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.box-page-title {
    color: #164c6d;
    font-size: 19px;
    -unity-font-style: bold;
}

.box-page-count {
    margin-top: 1px;
    color: #58737b;
    font-size: 10px;
    white-space: nowrap;
    flex-shrink: 0;
}

.box-page-navigation {
    width: 86px;
    min-width: 86px;
    flex-shrink: 0;
    margin-right: 8px;
    justify-content: space-between;
}

.box-page-button {
    width: 38px;
    height: 38px;
    padding: 0;
    color: #174c73;
    background-color: #f7fbfb;
    border-width: 1px;
    border-color: #9dbfba;
    border-radius: 8px;
    font-size: 24px;
    -unity-font-style: bold;
}

.box-search-field {
    flex-grow: 1;
    min-width: 130px;
    height: 36px;
    margin-left: 10px;
    margin-right: 8px;
}

.box-search-field .unity-text-input {
    color: #294b55;
    border-width: 1px;
    border-color: #acd0c8;
    border-radius: 7px;
    font-size: 11px;
    background-color: var(--menu-surface, #ffffff);
}

.box-sort-group {
    width: 280px;
    min-width: 220px;
}

.box-filter-toggle {
    width: 104px;
    height: 36px;
    margin-right: 7px;
    color: #254d59;
    background-color: #f4faf8;
    border-width: 1px;
    border-color: #aacbc4;
    border-radius: 7px;
    font-size: 11px;
}

.box-sort-field {
    flex-grow: 1;
    min-width: 110px;
    height: 36px;
    padding-left: 12px;
    padding-right: 10px;
    color: #294b55;
    background-color: #fbfefd;
    border-width: 1px;
    border-color: #acd0c8;
    border-radius: 7px;
    font-size: 11px;
    -unity-text-align: middle-left;
}

.box-capacity-group {
    width: 86px;
    min-width: 86px;
    margin-left: 7px;
    justify-content: flex-end;
}

.box-capacity-label {
    color: #285764;
    font-size: 12px;
    -unity-font-style: bold;
}

.box-expand-button {
    width: 29px;
    height: 29px;
    margin-left: 5px;
    padding: 0;
    color: white;
    background-color: #2e9d92;
    border-radius: 7px;
    font-size: 18px;
    -unity-font-style: bold;
}

.box-filter-panel {
    position: absolute;
    top: 58px;
    right: 12px;
    width: 510px;
    min-height: 70px;
    display: none;
    padding: 8px;
    flex-direction: row;
    flex-wrap: wrap;
    background-color: #f6fcfa;
    border-width: 1px;
    border-color: #9fc6bd;
    border-radius: 9px;
}

.box-sort-popup {
    position: absolute;
    top: 58px;
    right: 96px;
    width: 224px;
    height: 220px;
    display: none;
    padding: 4px;
    overflow: hidden;
    background-color: #fbfefd;
    border-width: 1px;
    border-color: #8fb9b0;
    border-radius: 7px;
}

.box-sort-scroll {
    width: 100%;
    height: 100%;
}

.box-sort-scroll .unity-scroll-view__horizontal-scroller {
    display: none;
}

.box-sort-scroll .unity-scroll-view__vertical-scroller {
    display: flex;
}

.box-sort-scroll .unity-scroll-view__content-container {
    width: 100%;
    min-width: 0;
}

.box-sort-option {
    width: 100%;
    height: 34px;
    min-height: 34px;
    flex-shrink: 0;
    margin: 0;
    padding-left: 11px;
    padding-right: 8px;
    color: #294b55;
    background-color: #fbfefd;
    border-width: 0;
    font-size: 11px;
    -unity-text-align: middle-left;
}

.box-sort-option:hover {
    background-color: #e6f4ef;
}

.box-sort-option.is-selected {
    color: white;
    background-color: #2f9489;
}

.box-filter-chip {
    height: 28px;
    margin-right: 5px;
    margin-bottom: 5px;
    padding-left: 9px;
    padding-right: 9px;
    color: #405e66;
    background-color: #ffffff;
    border-radius: 6px;
}

.box-filter-chip.is-selected {
    color: white;
    background-color: #2f9489;
}

.box-storage-scroll {
    flex-grow: 1;
    width: 100%;
    min-width: 0;
    min-height: 0;
    margin-top: 2px;
    align-self: stretch;
}

.box-storage-scroll .unity-scroll-view__horizontal-scroller {
    display: none;
}

.box-storage-scroll .unity-scroll-view__vertical-scroller {
    display: flex;
}

.box-storage-scroll .unity-scroll-view__content-and-vertical-scroll-container {
    width: 100%;
    min-width: 0;
}

.box-storage-scroll .unity-scroll-view__content-viewport,
.box-storage-scroll .unity-scroll-view__content-container {
    width: 100%;
    min-width: 100%;
    align-self: stretch;
}

.box-storage-scroll .unity-scroll-view__content-container {
    align-items: center;
}

.box-storage-grid {
    width: 888px;
    min-width: 888px;
    height: 560px;
    min-height: 560px;
    align-self: center;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    justify-content: center;
}

.box-storage-card {
    position: relative;
    width: 136px;
    min-width: 136px;
    height: 100px;
    min-height: 100px;
    margin: 6px;
    padding: 4px;
    flex-grow: 0;
    flex-shrink: 0;
    overflow: hidden;
    color: #193e48;
    border-width: 1px;
    border-color: #bdd4cf;
    border-radius: 9px;
    background-color: var(--menu-surface, #ffffff);
}

.box-storage-card.is-locked {
    opacity: 0.28;
}

.box-storage-card.is-filtered-out {
    opacity: 0.2;
}

.box-storage-portrait {
    position: absolute;
    left: 4px;
    top: 4px;
    right: 4px;
    bottom: 4px;
    align-items: center;
    justify-content: center;
    -unity-background-scale-mode: scale-to-fit;
}

.box-storage-info {
    position: absolute;
    left: 4px;
    right: 4px;
    bottom: 4px;
    height: 34px;
    display: none;
    padding-top: 2px;
    padding-right: 5px;
    padding-bottom: 2px;
    padding-left: 5px;
    justify-content: center;
    border-radius: 5px;
    background-color: var(--menu-surface, #ffffff);
}

.box-storage-card.is-selected .box-storage-info {
    display: flex;
}

.box-storage-name {
    height: 17px;
    color: #173e4a;
    font-size: 11px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.box-storage-meta {
    height: 14px;
    color: #557078;
    font-size: 9px;
}

.box-empty-slot-content {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    opacity: 0.68;
}

.box-empty-slot-icon {
    width: 50px;
    height: 50px;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    color: rgb(130, 151, 148);
    background-color: rgb(228, 237, 234);
    border-radius: 25px;
    font-size: 22px;
    -unity-text-align: middle-center;
}

.box-empty-slot-text {
    height: 22px;
    margin-top: 2px;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding: 0;
    color: #557078;
    font-size: 12px;
    -unity-text-align: middle-center;
}

.box-storage-empty-icon,
.box-storage-index,
.box-empty-plus {
    display: none;
}

.box-empty-label {
    position: absolute;
    left: 0;
    top: 50%;
    right: 0;
    display: none;
    color: #8aa29d;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.box-selected-panel {
    width: 35%;
    min-width: 430px;
    margin-left: 10px;
    flex-shrink: 0;
    padding: 14px;
    background-color: var(--menu-surface, #ffffff);
}

.box-selected-title-row {
    height: 46px;
    min-height: 46px;
    padding-bottom: 7px;
    border-bottom-width: 1px;
    border-bottom-color: #c7ded9;
}

.box-selected-element-icon {
    width: 36px;
    color: #775398;
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.box-selected-name {
    flex-grow: 1;
    min-width: 0;
    color: #123f73;
    font-size: 25px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.box-selected-level {
    margin-left: 8px;
    color: #153f70;
    font-size: 21px;
    -unity-font-style: bold;
}

.box-selected-favorite {
    width: 28px;
    height: 28px;
    margin-left: 6px;
    color: #e4ae27;
    font-size: 20px;
    -unity-text-align: middle-center;
}

.box-selected-location {
    height: 24px;
    padding-top: 5px;
    color: #526f78;
    font-size: 11px;
}

.box-selected-meta-row {
    height: 66px;
    min-height: 66px;
    margin-top: 4px;
    margin-bottom: 10px;
}

.box-meta-item {
    min-width: 0;
    height: 58px;
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 6px;
    padding-top: 6px;
    padding-right: 8px;
    padding-bottom: 6px;
    padding-left: 8px;
    justify-content: center;
    border-width: 1px;
    border-color: #c5ddd8;
    border-radius: 8px;
    background-color: var(--menu-surface, #ffffff);
}

.box-meta-caption {
    color: #638087;
    font-size: 10px;
}

.box-meta-value {
    margin-top: 3px;
    color: #194b60;
    font-size: 13px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.box-rarity-value {
    color: #8a5cb4;
}

.box-selected-body {
    flex-grow: 1;
    height: 340px;
    min-height: 340px;
    width: 100%;
    align-items: stretch;
}

.box-selected-body-scroll {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

.box-selected-body-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    flex-grow: 1;
}

.box-selected-left {
    width: 43%;
    min-width: 0;
    height: 100%;
    margin-right: 10px;
}

.box-selected-right {
    flex-grow: 1;
    min-width: 0;
    height: 100%;
}

.box-selected-portrait {
    position: relative;
    width: 100%;
    height: 58%;
    min-height: 190px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-width: 1px;
    border-color: #bfd9d3;
    border-radius: 10px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: var(--menu-surface, #ffffff);
}

.box-selected-portrait-fallback {
    width: 100%;
    height: 100%;
    color: #85aaa3;
    font-size: 58px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.box-nature-card {
    flex-grow: 1;
    min-height: 112px;
    margin-top: 9px;
    padding: 10px;
    border-width: 1px;
    border-color: #c4ddd7;
    border-radius: 9px;
    background-color: var(--menu-surface, #ffffff);
}

.box-nature-title {
    color: #54777d;
    font-size: 11px;
    -unity-font-style: bold;
}

.box-nature-name {
    margin-top: 3px;
    margin-bottom: 8px;
    padding-bottom: 7px;
    color: #163f6c;
    font-size: 16px;
    -unity-font-style: bold;
    border-bottom-width: 1px;
    border-bottom-color: #d4e6e1;
}

.box-health-card {
    height: 128px;
    min-height: 128px;
    flex-shrink: 0;
    padding-top: 10px;
    padding-right: 11px;
    padding-bottom: 10px;
    padding-left: 11px;
    border-width: 1px;
    border-color: #c7ded9;
    border-radius: 9px;
    background-color: var(--menu-surface, #ffffff);
}

.box-health-row {
    justify-content: space-between;
}

.box-health-label,
.box-health-value {
    color: #174773;
    font-size: 13px;
    -unity-font-style: bold;
}

.box-health-track {
    height: 10px;
    margin-top: 10px;
    overflow: hidden;
    background-color: #dfe9e6;
    border-radius: 5px;
}

.box-health-fill {
    width: 0%;
    height: 100%;
    background-color: #46c76a;
    border-radius: 5px;
}

.box-radar-area {
    position: relative;
    flex-grow: 1;
    min-height: 170px;
    margin-top: 8px;
}

.box-radar-host {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.box-radar-chart {
    width: 100%;
    height: 100%;
}

.box-radar-label {
    position: absolute;
    color: #173f6d;
    font-size: 11px;
    -unity-font-style: bold;
}

.box-radar-label.is-up {
    color: #24a43e;
}

.box-radar-label.is-down {
    color: #e0474d;
}

.box-exp-row {
    margin-top: 12px;
}

.box-exp-fill {
    background-color: #328bd1;
}

.box-party-info {
    height: 52px;
    min-height: 52px;
    flex-shrink: 0;
    padding-top: 2px;
}

.box-party-name {
    height: 20px;
    margin: 0;
    padding: 0;
    font-size: 12px;
    color: #17373f;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.box-party-hp-row {
    height: 14px;
    min-height: 14px;
    flex-direction: row;
    align-items: center;
}

.box-party-hp-label {
    width: 20px;
    min-width: 20px;
    margin: 0;
    padding: 0;
    font-size: 10px;
    color: #2b4c42;
}

.box-party-hp-track {
    flex-grow: 1;
    min-width: 0;
    height: 6px;
    background-color: #dfe9e6;
    border-radius: 3px;
    overflow: hidden;
}

.box-party-hp-value {
    height: 16px;
    margin: 0;
    padding: 0;
    font-size: 10px;
    color: #224446;
    -unity-text-align: middle-right;
}

.box-context-actions {
    height: 112px;
    min-height: 112px;
    flex-shrink: 0;
    padding-top: 8px;
    justify-content: flex-end;
}

.box-secondary-actions {
    width: 100%;
}

.box-action-button {
    width: 100%;
    margin-left: 0;
    margin-right: 0;
    height: 48px;
    min-height: 48px;
    margin-top: 6px;
    color: #173e58;
    background-color: #f1f8f6;
    border-width: 1px;
    border-color: #9fc7bf;
    border-radius: 9px;
    font-size: 13px;
    -unity-font-style: bold;
}

.box-primary-action {
    color: white;
    background-color: rgb(43, 151, 66);
    border-color: rgb(37, 131, 56);
}

.box-primary-action:hover {
    background-color: rgb(50, 165, 74);
}

.box-half-action {
    width: auto;
    min-width: 0;
    flex-basis: 0;
    flex-grow: 1;
}

.box-replace-action {
    margin-right: 2%;
    color: white;
    background-color: #347ae7;
    border-color: #2768c8;
}

.box-action-button:disabled {
    opacity: 0.38;
}

.box-footer {
    height: 30px;
    min-height: 30px;
    padding-left: 18px;
    padding-right: 18px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-top-width: 1px;
    border-top-color: #d1e3de;
    background-color: var(--menu-background, #f8f4eb);
}

.box-feedback,
.box-footer-summary {
    color: #5a747b;
    font-size: 10px;
}

.box-purchase-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(17, 40, 44, 0.45);
}

.box-purchase-card {
    width: 410px;
    min-height: 330px;
    padding: 28px;
    border-width: 2px;
    border-color: #4b9c90;
    border-radius: 14px;
    background-color: var(--menu-surface, #ffffff);
}

.box-purchase-title {
    margin-bottom: 18px;
    color: #164e65;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.box-purchase-line {
    height: 37px;
    color: #465f65;
    font-size: 14px;
}

.box-purchase-after {
    margin-top: 4px;
    color: #1e8352;
    -unity-font-style: bold;
}

.box-purchase-actions {
    margin-top: 18px;
}

.box-popup-button {
    width: 48%;
    height: 44px;
    margin-right: 4%;
    color: #244a53;
    background-color: #eef6f3;
    border-radius: 8px;
    -unity-font-style: bold;
}

.box-panel {
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: auto;
    height: auto;
    border-width: 0;
    border-radius: 0;
    background-color: var(--menu-background, #f8f4eb);
}

.box-panel .screen-header .box-subtitle {
    display: none;
}

.box-search-field .unity-base-text-field__input {
    background-color: var(--menu-surface, #ffffff);
    color: #31573d;
    border-color: #becfb4;
    padding: 8px;
}
