<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:s="Capstone.Game.ShopSystem" editor-extension-mode="False">
    <ui:Style src="MenuTheme.uss" />
    <ui:Style src="MenuCommon.uss" />
    <ui:Style src="ShopScreen.uss" />
    <ui:Style src="MenuScreenHeader.uss" />
    <ui:VisualElement name="shop-panel" class="shop-panel menu-theme">
        <ui:VisualElement class="screen-header">
            <ui:VisualElement class="screen-heading">
                <ui:VisualElement class="screen-heading-mark" picking-mode="Ignore" focusable="false" />
                <ui:Label text="CỬA HÀNG" class="screen-title" />
            </ui:VisualElement>
            <ui:Label text="Mua sắm vật phẩm và vật tư cho hành trình phiêu lưu" class="shop-subtitle" />
            <ui:VisualElement class="inventory-currency" tooltip="Vàng đang sở hữu">
                <ui:Label text="G" class="inventory-currency-icon" />
                <ui:Label name="shop-gold" text="—" class="inventory-gold-value" />
            </ui:VisualElement>
            <s:ShopAButton name="shop-back" text="←  TRỞ LẠI" class="screen-back" />
        </ui:VisualElement>
        <ui:VisualElement class="shop-body">
            <ui:ScrollView class="shop-sidebar shop-column" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                <s:ShopAButton name="shop-category-consumables" class="shop-category"><ui:Label text="+" class="shop-category-icon" picking-mode="Ignore" /><ui:Label class="shop-category-name" picking-mode="Ignore" /><ui:Label class="shop-category-count" picking-mode="Ignore" /></s:ShopAButton>
                <s:ShopAButton name="shop-category-capture" class="shop-category"><ui:Label text="◉" class="shop-category-icon" picking-mode="Ignore" /><ui:Label class="shop-category-name" picking-mode="Ignore" /><ui:Label class="shop-category-count" picking-mode="Ignore" /></s:ShopAButton>
                <s:ShopAButton name="shop-category-materials" class="shop-category"><ui:Label text="◇" class="shop-category-icon" picking-mode="Ignore" /><ui:Label class="shop-category-name" picking-mode="Ignore" /><ui:Label class="shop-category-count" picking-mode="Ignore" /></s:ShopAButton>
                <s:ShopAButton name="shop-category-special" class="shop-category"><ui:Label text="★" class="shop-category-icon" picking-mode="Ignore" /><ui:Label class="shop-category-name" picking-mode="Ignore" /><ui:Label class="shop-category-count" picking-mode="Ignore" /></s:ShopAButton>
                <s:ShopAButton name="shop-category-evolution" class="shop-category"><ui:Label text="◆" class="shop-category-icon" picking-mode="Ignore" /><ui:Label class="shop-category-name" picking-mode="Ignore" /><ui:Label class="shop-category-count" picking-mode="Ignore" /></s:ShopAButton>
            </ui:ScrollView>
            <ui:VisualElement class="shop-products shop-column">
                <ui:VisualElement class="shop-toolbar">
                    <ui:VisualElement name="shop-search-group" class="shop-search-group">
                    <ui:VisualElement name="shop-search-glyph" picking-mode="Ignore" />
                    <ui:TextField name="shop-search" placeholder-text="Tìm kiếm vật phẩm..." class="shop-search" />
                    <s:ShopAButton name="shop-clear" text="×" tooltip="Xóa tìm kiếm" class="shop-search-clear" />
                    </ui:VisualElement>
                    <ui:DropdownField name="shop-sort" class="shop-sort" />
                </ui:VisualElement>
                <ui:ScrollView class="shop-grid-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                    <ui:VisualElement name="shop-grid" class="shop-grid" />
                    <ui:Label name="shop-empty" text="Hiện chưa có vật phẩm." class="menu-detail-empty" />
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement class="shop-details shop-column">
                <ui:Label name="shop-detail-empty" text="Chọn vật phẩm để xem thông tin." class="menu-detail-empty" />
                <ui:ScrollView name="shop-detail" class="shop-detail-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                    <ui:VisualElement class="shop-portrait-frame"><ui:Image name="shop-portrait" class="shop-portrait" scale-mode="ScaleToFit" /></ui:VisualElement>
                    <ui:VisualElement class="ui-copy-section">
                    <ui:Label name="shop-item-name" class="shop-item-name" />
                    <ui:Label name="shop-owned" class="shop-owned" />
                    <ui:VisualElement class="shop-badges"><ui:Label name="shop-item-category" class="shop-badge" /><ui:Label name="shop-rarity" class="shop-badge" /></ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="ui-copy-section">
                    <ui:Label text="MÔ TẢ" class="ui-section-heading" picking-mode="Ignore" />
                    <ui:Label name="shop-description" class="shop-description" />
                    </ui:VisualElement>
                    <ui:VisualElement class="shop-effect-section ui-copy-section"><ui:Label text="HIỆU QUẢ" class="shop-section-title" /><ui:Label name="shop-effect" class="shop-description" /></ui:VisualElement>
                    <ui:Label name="shop-stock" class="shop-owned" />
                </ui:ScrollView>
                <ui:VisualElement name="shop-purchase" class="shop-purchase">
                    <ui:Label text="Số lượng" class="shop-section-title" />
                    <ui:VisualElement class="shop-quantity-row">
                        <s:ShopAButton name="shop-minus" text="−" tooltip="Giảm số lượng" />
                        <ui:IntegerField name="shop-quantity" value="1" is-delayed="true" tooltip="Số lượng cần mua" />
                        <s:ShopAButton name="shop-plus" text="+" tooltip="Tăng số lượng" />
                        <s:ShopAButton name="shop-max" text="Tối đa" />
                    </ui:VisualElement>
                    <ui:VisualElement class="shop-total-row"><ui:Label text="Tổng giá" /><ui:Label name="shop-total" /></ui:VisualElement>
                    <ui:Label name="shop-reason" class="shop-reason" />
                    <s:ShopAButton name="shop-buy" text="MUA" class="action-button primary-action shop-buy" />
                </ui:VisualElement>
                <ui:Label name="shop-feedback" class="shop-feedback" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
