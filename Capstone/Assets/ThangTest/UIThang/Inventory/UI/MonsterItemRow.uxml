<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- Load theme, shared controls, panel styles, then the shared header. -->
    <ui:Style src="MenuTheme.uss" />
    <ui:Style src="MenuCommon.uss" />
    <ui:Style src="InventoryPanel.uss" />
    <ui:VisualElement name="monster-item-row" class="item-row menu-theme">
        <ui:VisualElement name="row-icon" class="item-row-icon" />
        <ui:VisualElement class="item-row-text">
            <ui:Label name="row-name" text="Tên vật phẩm" class="item-row-name" />
            <ui:Label name="row-category" text="Category" class="item-row-category" />
        </ui:VisualElement>
        <ui:Label name="row-quantity" text="x0" class="item-row-quantity" />
    </ui:VisualElement>
</ui:UXML>
