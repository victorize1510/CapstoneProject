/* Owning panel rules. Shared colors come from MenuTheme.uss. */

.settings-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    color: #174a30;
    -unity-font: url("../../../../TextMesh Pro/Fonts/LiberationSans.ttf");
    font-size: 18px;
    background-color: var(--menu-background, #f8f4eb);
}

.settings-panel .screen-header {
    border-bottom-width: 1px;
    border-bottom-color: #cddac4;
}

.settings-subtitle {
    flex-grow: 1;
    min-width: 0;
    margin-top: 0;
    margin-right: 24px;
    margin-bottom: 0;
    margin-left: 24px;
    color: #677961;
    font-size: 18px;
    white-space: normal;
}

.settings-body {
    flex-grow: 1;
    min-height: 0;
    padding: 20px;
}

.settings-grid-row {
    flex-direction: row;
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

.settings-bottom-row {
    margin-top: 18px;
}

.settings-group {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
    border-width: 1px;
    border-color: #becfb4;
    border-radius: 12px;
    padding: 24px;
    background-color: var(--menu-surface, #ffffff);
}

.settings-left-group {
    margin-right: 18px;
}

.settings-section-heading {
    flex-direction: row;
    align-items: center;
    min-height: 44px;
    margin-bottom: 12px;
    flex-shrink: 0;
}

.settings-section-title {
    font-size: 27px;
    -unity-font-style: bold;
    color: #244d34;
    white-space: normal;
}

.settings-heading-line {
    flex-grow: 1;
    height: 1px;
    background-color: #d4c595;
    margin-left: 20px;
}

.settings-section-scroll {
    flex-grow: 1;
    min-height: 0;
}

.settings-section-scroll .unity-scroll-view__content-container > TemplateContainer {
    flex-shrink: 0;
}

.settings-row {
    flex-direction: row;
    align-items: center;
    min-height: 52px;
    margin-bottom: 6px;
}

.settings-panel .settings-row-label {
    width: 48%;
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
    color: #244d34;
    font-size: 19px;
    margin-right: 16px;
}

.settings-slider {
    flex-grow: 1;
    min-width: 80px;
    height: 38px;
    margin: 0;
}

.settings-panel .settings-percent {
    width: 62px;
    flex-shrink: 0;
    margin-left: 14px;
    color: #244d34;
    font-size: 19px;
    -unity-text-align: middle-right;
}

.settings-slider .unity-base-slider__tracker {
    height: 7px;
    background-color: #e4e9dd;
    border-radius: 4px;
    border-width: 1px;
    border-color: #cddac4;
}

.settings-slider-fill {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    background-color: #548b5c;
    border-radius: 4px;
}

.settings-slider .unity-base-slider__dragger {
    width: 17px;
    height: 17px;
    background-color: #f7f9f1;
    border-width: 2px;
    border-color: #548b5c;
    rotate: 45deg;
    border-radius: 2px;
}

.settings-slider .unity-base-slider__dragger:hover {
    border-color: #c6a34d;
}

.settings-toggle-row .settings-row-label {
    flex-grow: 1;
}

.settings-switch {
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    width: 68px;
}

.settings-switch .unity-toggle__input {
    width: 64px;
    min-width: 64px;
    max-width: 64px;
    height: 32px;
    min-height: 32px;
    padding: 4px;
    border-radius: 16px;
    background-color: #b4bbae;
    border-width: 0;
    flex-grow: 0;
    flex-shrink: 0;
}

.settings-switch .unity-toggle__checkmark {
    display: none;
}

.settings-switch-thumb {
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background-color: #fffdf6;
    flex-shrink: 0;
}

.settings-switch:checked .unity-toggle__input {
    background-color: #357c4b;
}

.settings-switch:checked .settings-switch-thumb {
    margin-left: 28px;
}

.settings-panel .settings-toggle-value {
    width: 52px;
    margin-left: 10px;
    color: #68765f;
    font-size: 18px;
}

.settings-panel .settings-toggle-value.is-on {
    color: #2c7545;
}

.settings-dropdown,
.settings-secondary {
    flex-grow: 1;
    min-width: 0;
    height: 42px;
    margin: 0;
}

.settings-panel .settings-dropdown .unity-base-field__input {
    color: #244d34;
    background-color: #fffdf6;
    border-width: 1px;
    border-color: #becfb4;
    border-radius: 7px;
    padding: 8px;
}

.settings-panel .unity-popup-field__text {
    font-size: 18px;
    color: #244d34;
}

.settings-secondary {
    color: #31573d;
    background-color: #f7f9f1;
    border-width: 1px;
    border-color: #becfb4;
    border-radius: 7px;
    font-size: 18px;
}

.settings-secondary:hover {
    background-color: #e5eede;
}

.settings-panel Button:focus,
.settings-switch:focus .unity-toggle__input,
.settings-slider:focus .unity-base-slider__dragger {
    border-color: var(--menu-focus-border, #c6a34d);
}

.settings-switch:focus .unity-toggle__input {
    border-width: 2px;
    padding: 2px;
}

.settings-panel .settings-dropdown:focus .unity-base-field__input {
    border-color: var(--menu-focus-border, #c6a34d);
}

.settings-panel .settings-note {
    white-space: normal;
    color: #68765f;
    font-size: 16px;
    margin-top: 8px;
    margin-bottom: 8px;
}

.settings-divider {
    height: 1px;
    background-color: #d4dabc;
    margin-top: 10px;
    margin-bottom: 12px;
}

.settings-panel #settings-other-group .settings-row {
    min-height: 44px;
    margin-bottom: 4px;
}

.settings-panel :disabled .settings-toggle-value,
.settings-panel :disabled .settings-row-label {
    color: #68765f;
}

.settings-modal {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(12, 22, 18, .56);
}

.settings-modal-card {
    width: 680px;
    max-width: 90%;
    max-height: 85%;
    padding: 24px;
    border-width: 1px;
    border-color: #a9bd9c;
    border-radius: 12px;
    background-color: var(--menu-surface, #ffffff);
}

.settings-panel .settings-modal-title {
    color: #174a30;
    font-size: 26px;
    -unity-font-style: bold;
    margin-bottom: 16px;
    white-space: normal;
}

.settings-modal-scroll {
    min-height: 100px;
    max-height: 430px;
}

.settings-panel .settings-modal-text {
    white-space: normal;
    color: #244d34;
    font-size: 19px;
}

.settings-panel .settings-modal-error {
    color: #a5433c;
    white-space: normal;
    font-size: 17px;
    margin-top: 12px;
    margin-right: 0;
    margin-bottom: 12px;
    margin-left: 0;
}

.settings-modal-actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 16px;
}

.settings-modal-actions Button {
    min-width: 130px;
    width: auto;
    flex-grow: 0;
    height: 42px;
    margin-left: 8px;
    font-size: 17px;
}
