  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CreditsRoll
  gameTitle: 
  subtitle: Capstone Project - VTC Academy
  logo: {fileID: 21300000, guid: bdd0cb7203251ce4ea5cb7794df241b9, type: 3}
  sections:
  - title: "NH\xD3M PH\xC1T TRI\u1EC2N"
    lines: "L\u01B0u Qu\u1ED1c Trung\nV\xF5 T\xE1 Minh Th\u1EAFng"
    image: {fileID: 0}
  - title: "THI\u1EBET K\u1EBE GAME"
    lines: "L\u01B0u Qu\u1ED1c Trung"
    image: {fileID: 0}
  - title: "L\u1EACP TR\xCCNH H\u1EC6 TH\u1ED0NG GAMEPLAY"
    lines: "V\xF5 T\xE1 Minh Th\u1EAFngChi\u1EBFn \u0111\u1EA5u th\u1EDDi gian th\u1EF1c,
      b\u1EAFt th\xFA, \u0111\u1ED9i h\xECnh, k\u1EF9 n\u0103ng\nNhi\u1EC7m v\u1EE5,
      b\u1EA3n \u0111\u1ED3, c\u1EEDa h\xE0ng, l\u01B0u game"
    image: {fileID: 0}
  - title: "L\u1EACP TR\xCCNH C\u1ED0T TRUY\u1EC6N & GIAO DI\u1EC6N"
    lines: "L\u01B0u Qu\u1ED1c Trung\nMain Menu, t\u1EA1o nh\xE2n v\u1EADt, \u0111o\u1EA1n
      m\u1EDF \u0111\u1EA7u\nCutscene tr\u01B0\u1EDFng l\xE0ng, ch\u1ECDn th\xFA
      kh\u1EDFi \u0111\u1EA7u\nTi\u1EBFn h\xF3a, \xF4 l\u01B0u game, \xE2m thanh
      & nh\u1EA1c"
    image: {fileID: 0}
  - title: BOSS
    lines: "L\u01B0u Qu\u1ED1c Trung\nDetale C\u1ED5 \u0110\u1EA1i - AI, k\u1EF9
      n\u0103ng, hi\u1EC7u \u1EE9ng"
    image: {fileID: 0}
  - title: "\u0110\u1ED2 H\u1ECCA & HI\u1EC6U \u1EE8NG"
    lines: "Trong B\xE1o c\xE1o"
    image: {fileID: 0}
  - title: "\xC2M NH\u1EA0C & \xC2M THANH"
    lines: "Trong B\xE1o C\xE1o"
    image: {fileID: 0}
  - title: "C\xD4NG C\u1EE4"
    lines: 'Unity 6.3 LTS (URP)

      Unity Version Control'
    image: {fileID: 0}
  - title: "GI\u1EA2NG VI\xCAN H\u01AF\u1EDANG D\u1EAAN"
    lines: "Nguy\u1EC5n Ng\u1ECDc Ch\u1EA5n"
    image: {fileID: 0}
  - title: "C\u1EA2M \u01A0N \u0110\u1EB6C BI\u1EC6T"
    lines: "VTC Academy\nTh\u1EA7y c\xF4 v\xE0 b\u1EA1n b\xE8 \u0111\xE3 xem nh\xF3m
      t\u1EE5i em b\xE1o c\xE1o d\u1EE5 \xE1n"
    image: {fileID: 0}
  thankYouText: "C\u1EA3m \u01A1n b\u1EA1n \u0111\xE3 ch\u01A1i!"
