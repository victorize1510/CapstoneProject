--- !u!114 &1533740126
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1533740125}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9c44aa71a76bf4444926999bb16628fd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ChiefStarterTalk
  npc: {fileID: 1098205783}
  npcName: "Tr\u01B0\u1EDFng l\xE0ng"
  npcPortrait: {fileID: 0}
  playerPortrait: {fileID: 0}
  npcTurnBackAfter: 1
  playerFacesNpc: 1
  turnSpeed: 360
  playerIdleState: IdleNeutral
  requireElderIntro: 0
  ballTable: {fileID: 1209891443}
  lines:
  - speaker: 0
    text: "A, {name} t\u1EDBi r\u1ED3i \u0111\u1EA5y \xE0! V\xE0o \u0111\xE2y, v\xE0o
      \u0111\xE2y, \xF4ng ch\u1EDD ch\xE1u n\xE3y gi\u1EDD."
  - speaker: 0
    text: "Ch\xE1u th\u1EA5y ba qu\u1EA3 b\xF3ng th\xFA tr\xEAn b\xE0n kia ch\u1EE9?
      Trong m\u1ED7i qu\u1EA3 l\xE0 m\u1ED9t b\xE9 th\xFA \u0111ang ch\u1EDD ng\u01B0\u1EDDi
      b\u1EA1n \u0111\u1ED3ng h\xE0nh c\u1EE7a m\xECnh."
  - speaker: 0
    text: "M\u1ED7i b\xE9 mang m\u1ED9t h\u1EC7 v\xE0 m\u1ED9t t\xEDnh c\xE1ch kh\xE1c
      nhau. C\xF3 b\xE9 m\u1EA1nh m\u1EBD, c\xF3 b\xE9 nhanh nh\u1EB9n, c\xF3 b\xE9
      l\u1EA1i r\u1EA5t hi\u1EC1n l\xE0nh."
  - speaker: 1
    text: "Ch\xE1u \u0111\u01B0\u1EE3c ch\u1ECDn b\xE9 n\xE0o c\u0169ng \u0111\u01B0\u1EE3c
      \u1EA1?"
  - speaker: 0
    text: "\u0110\xFAng v\u1EADy, nh\u01B0ng ch\u1EC9 \u0111\u01B0\u1EE3c ch\u1ECDn
      m\u1ED9t th\xF4i. H\xE3y xem k\u1EF9 t\u1EEBng b\xE9 r\u1ED3i h\u1EB5ng quy\u1EBFt
      \u0111\u1ECBnh nh\xE9."
  - speaker: 0
    text: "Ng\u01B0\u1EDDi b\u1EA1n \u0111\u1EA7u ti\xEAn s\u1EBD \u0111i c\xF9ng
      ch\xE1u su\u1ED1t c\u1EA3 h\xE0nh tr\xECnh. H\xE3y lu\xF4n tin t\u01B0\u1EDFng
      v\xE0 ch\u0103m s\xF3c n\xF3 th\u1EADt t\u1ED1t."
  - speaker: 1
    text: "Ch\xE1u c\u1EA3m \u01A1n \xF4ng! Ch\xE1u h\u1ED3i h\u1ED9p qu\xE1!"
  - speaker: 0
    text: "Ha ha! L\u1EA1i g\u1EA7n b\xE0n \u0111\u1EC3 xem t\u1EEBng qu\u1EA3 b\xF3ng
      \u0111i. H\xE0nh tr\xECnh c\u1EE7a ch\xE1u b\u1EAFt \u0111\u1EA7u t\u1EEB \u0111\xE2y
      \u0111\u1EA5y!"
  typingSpeed: 40
  dialogueBox: {fileID: 0}
