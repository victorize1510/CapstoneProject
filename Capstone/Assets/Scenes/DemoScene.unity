--- !u!114 &253385102
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 253385101}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 114d89e1f65b40f46af8c285bf0770e2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::VillageChiefCutscene
  npc: {fileID: 892991756}
  npcName: "Tr\u01B0\u1EDFng l\xE0ng"
  npcPortrait: {fileID: 0}
  npcAnimator: {fileID: 892991755}
  npcIdleState: Idle
  npcWalkState: Walk
  npcSpeedParameter: Speed
  npcWalkSpeed: 1.4
  approachPath:
  - {fileID: 0}
  - {fileID: 157222162}
  - {fileID: 262694271}
  returnHomeAfterTalk: 1
  hideNpcUntilCutscene: 1
  npcStaysHomeBeforeCutscene: 1
  npcAppearDelay: 0.5
  npcFinalPoint: {fileID: 1768047596}
  snapNpcToGround: 1
  playerStandPoint: {fileID: 1361967552}
  playerIdleState: IdleNeutral
  playerPortrait: {fileID: 0}
  approachCamera: {fileID: 212213656}
  talkCamera: {fileID: 150061067}
  cameraBlendTime: 1.2
  cameraLooksAtNpc: 0
  useFadeTransitions: 0
  waitUntilNpcHome: 1
  maxWaitNpcHome: 15
  watchNpcLeaveTime: 2.5
  lines:
  - speaker: 0
    text: "A, {name}! Ch\xE1u d\u1EADy r\u1ED3i \u0111\u1EA5y \xE0? \xD4ng \u0111ang
      \u0111\u1ECBnh qua g\u1ECDi ch\xE1u \u0111\xE2y."
  - speaker: 1
    text: "Ch\xE0o \xF4ng tr\u01B0\u1EDFng l\xE0ng! H\xF4m nay \xF4ng c\xF3 chuy\u1EC7n
      g\xEC v\u1EADy \u1EA1?"
  - speaker: 0
    text: "H\xF4m nay l\xE0 ng\xE0y ch\xE1u \u0111\u1EE7 tu\u1ED5i tr\u1EDF th\xE0nh
      Nh\xE0 Hu\u1EA5n Luy\u1EC7n r\u1ED3i."
  - speaker: 0
    text: "\xD4ng \u0111\xE3 chu\u1EA9n b\u1ECB s\u1EB5n m\u1EA5y qu\u1EA3 b\xF3ng
      th\xFA cho ch\xE1u ch\u1ECDn ng\u01B0\u1EDDi b\u1EA1n \u0111\u1ED3ng h\xE0nh
      \u0111\u1EA7u ti\xEAn."
  - speaker: 1
    text: "Th\u1EADt \u1EA1?! Ch\xE1u ch\u1EDD ng\xE0y n\xE0y l\xE2u l\u1EAFm r\u1ED3i!"
  - speaker: 0
    text: "Ha ha, \xF4ng bi\u1EBFt m\xE0. Gh\xE9 qua nh\xE0 \xF4ng nh\xE9, b\xF3ng
      th\xFA \u0111\u1EC3 tr\xEAn b\xE0n \u0111\u1EA5y."
  - speaker: 0
    text: "\xD4ng v\u1EC1 tr\u01B0\u1EDBc chu\u1EA9n b\u1ECB. \u0110\u1EEBng \u0111\u1EC3
      \xF4ng ch\u1EDD l\xE2u nh\xE9!"
  typingSpeed: 40
  dialogueBox: {fileID: 1494329589}
  playOnlyOnce: 1
  onFinished:
    m_PersistentCalls:
      m_Calls: []
